#!/usr/bin/env bash
# Compatibility entrypoint for the old root install script.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"

echo "The unsafe legacy installer has been retired." >&2
echo "Running the maintained Debian/Ubuntu prerequisite helper." >&2
echo "See wiki/hosting-guide.md before exposing either server port." >&2

exec "$REPO_ROOT/scripts/setup_linux.sh" "$@"
