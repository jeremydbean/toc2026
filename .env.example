# The installers create .env automatically and never replace an existing token.
# Copy this file manually only when you are not using an installer. Every
# setting is described in wiki/install-guide.md.
TOC_MODE=docker
TOC_STATE=./state
TOC_IMAGE=ghcr.io/jeremydbean/toc2026:latest
MUD_BIND=127.0.0.1
MUD_PORT=9000
WEB_ADMIN_BIND=127.0.0.1
WEB_ADMIN_PORT=9001
WEB_ADMIN_ENABLED=1
WEB_ADMIN_LOCAL_UNLOCK=1
TOC_UID=1000
TOC_GID=1000

# Replace this with at least 32 random bytes encoded as hex. Never commit it.
WEB_ADMIN_TOKEN=
