[Unit]
Description=Register the Times of Chaos appliance on the local network
Documentation=https://github.com/jeremydbean/toc2026
After=NetworkManager.service avahi-daemon.service
Before=toc2026-game.service toc2026-web.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/toc2026-local-discovery
RemainAfterExit=yes
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=toc2026-local-discovery

[Install]
WantedBy=multi-user.target
