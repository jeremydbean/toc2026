[Unit]
Description=Encrypt and synchronize ToC player files to GitHub
Documentation=https://github.com/jeremydbean/toc2026
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=toc
Group=toc
WorkingDirectory=/home/toc/toc2026
EnvironmentFile=/etc/toc2026/player-backup.env
ExecStart=/home/toc/toc2026/deploy/sync-player-backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=10
TasksMax=32
MemoryMax=96M
MemorySwapMax=64M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/toc/toc2026/player
StandardOutput=journal
StandardError=journal
SyslogIdentifier=toc2026-player-backup
