[Unit]
Description=End-to-end health check and local repair for Times of Chaos
Documentation=https://github.com/jeremydbean/toc2026
After=toc2026-game.service toc2026-web.service
OnFailure=toc2026-recovery.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/toc2026-healthcheck
TimeoutStartSec=2min
UMask=0022
Nice=10
IOSchedulingClass=idle
CPUWeight=10
TasksMax=16
MemoryMax=32M
MemorySwapMax=16M
OOMPolicy=stop
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=toc2026-healthcheck
