# Installed as /etc/toc/player-backup.env with mode 0600 (the Oracle host;
# toc-player-backup.service reads it). Every value here is also the
# script's default.
TOC_ROOT=/srv/toc/current
BACKUP_REMOTE=git@github.com:jeremydbean/toc2026-player-backups.git
BACKUP_BRANCH=snapshots
AGE_RECIPIENT_FILE=/etc/toc/player-backup-recipient.txt
GIT_SSH_KEY=/srv/toc/.ssh/id_ed25519_github_toc_backup
