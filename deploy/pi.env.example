# Raspberry Pi LAN appliance settings. Copy these values into the private
# repository-root .env and replace the token placeholder before installing.
MUD_BIND=0.0.0.0
MUD_PORT=9000
MUD_HOST=127.0.0.1
# Shown on the dashboard as the game endpoint. MUD_HOST above is only where
# the web service dials; this is what a player would type.
MUD_PUBLIC_HOST=toc.jeremybean.com
WEB_ADMIN_BIND=0.0.0.0
WEB_ADMIN_PORT=9001
WEB_ADMIN_ENABLED=1
WEB_ADMIN_LOCAL_UNLOCK=0
WEB_ADMIN_HOST_STATUS=1
WEB_ADMIN_TOKEN=replace-with-a-long-random-token
