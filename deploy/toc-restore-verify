#!/bin/sh
# Prove units are running after a restore, or say which are not
# (review, 2026-11-24: toc-restore enabled every unit with `|| true` and
# announced a running game whatever had happened).
#
#   toc-restore-verify [--active-only] [--backup-key KEY --backup-remote URL
#                       [--as USER] [--home DIR] [--sync-receipts DIR --since EPOCH
#                       [--state-repo DIR --tree DIR]]]
#                      REQUIRED... [-- WANTED...]
#
# Each REQUIRED unit must be active -- waited for up to
# TOC_RESTORE_VERIFY_WAIT seconds (30), as a game takes a moment to boot --
# and enabled, so it comes back after a reboot (--active-only: active is
# enough, for units a restore only started again). A WANTED unit that is
# not is named as a warning.
#
# Review, 2026-11-24 (third): a sync timer that is running proves nothing
# about backups on a fresh host with no deploy key -- every run fails, and
# this said success. With --backup-key, remote backups are judged apart:
# the key must be readable, and a dry-run push with it to --backup-remote
# must be accepted -- GitHub refuses a read-only or unknown key at that
# point, so write access is proved without writing anything.
#
# Review, 2026-11-24 (fourth): that check ran as the restore -- root -- and
# toc-state-sync.service runs as toc, with HOME=/srv/toc: a key only root
# could read, or a known_hosts only root had, passed here and failed every
# real sync. Run as root, the key is read and the push tried as --as (toc
# when that user exists) with --home as HOME and the sync's own ssh
# options. And push access is not a backup: with --sync-receipts (the
# sync's TOC_SYNC_STATE_DIR) remote backups are verified only by a
# last-success receipt written at or after --since -- a sync that really
# reached GitHub since the restore began. Without it the verdict says push
# access only.
#
# Review, 2026-11-27: a receipt proves a sync finished, not that it carried
# the restored state. With --state-repo (the sync's clone) and --tree (the
# restored game tree), the receipt's remote commit must be the clone's
# HEAD, the remote's branch must stand at it, and the clone's player,
# gods, heroes and corpse/live must be the tree's, file for file.
#
# Exit 0 when every required unit is running and, if asked, remote backups
# are verified; 1 when a required unit is not (each named on stderr); 3
# when the units are but remote backups are not verified. The last lines
# say which, as GAME and REMOTE BACKUPS.
set -u

active_only=0
backup_key=""
backup_remote=""
as_user=""
as_home=""
receipts=""
since=0
state_repo=""
tree=""
while :; do
    case "${1:-}" in
        --active-only) active_only=1; shift ;;
        --backup-key) backup_key=${2:-}; shift 2 ;;
        --backup-remote) backup_remote=${2:-}; shift 2 ;;
        --as) as_user=${2:-}; shift 2 ;;
        --home) as_home=${2:-}; shift 2 ;;
        --sync-receipts) receipts=${2:-}; shift 2 ;;
        --since) since=${2:-0}; shift 2 ;;
        --state-repo) state_repo=${2:-}; shift 2 ;;
        --tree) tree=${2:-}; shift 2 ;;
        *) break ;;
    esac
done
required=""
wanted=""
while [ $# -gt 0 ]; do
    if [ "$1" = -- ]; then shift; wanted="$*"; break; fi
    required="$required $1"; shift
done

wait_for=${TOC_RESTORE_VERIFY_WAIT:-30}
waited=0
pending=$required
while :; do
    still=""
    for u in $pending; do
        systemctl is-active --quiet "$u" 2>/dev/null || still="$still $u"
    done
    pending=$still
    [ -z "$pending" ] && break
    [ "$waited" -ge "$wait_for" ] && break
    sleep 1; waited=$((waited + 1))
done

bad=0
for u in $required; do
    case " $pending " in
        *" $u "*) echo "   NOT RUNNING $u: $(systemctl is-active "$u" 2>/dev/null || true)" >&2; bad=1; continue ;;
    esac
    if [ "$active_only" = 0 ] && ! systemctl is-enabled --quiet "$u" 2>/dev/null; then
        echo "   NOT ENABLED $u: it will not come back after a reboot" >&2
        bad=1
        continue
    fi
    echo "   running $u"
done
for u in $wanted; do
    if systemctl is-active --quiet "$u" 2>/dev/null; then
        echo "   running $u"
    else
        echo "   WARN: $u is not running: $(systemctl is-active "$u" 2>/dev/null || true)" >&2
    fi
done

if [ "$bad" = 0 ]; then
    echo "   GAME: running -- every required unit is active"
else
    echo "   GAME: NOT VERIFIED -- see the units named above" >&2
fi
[ -z "$backup_key" ] && exit $bad

# Who the sync runs as. Root asks as that user; anyone else is asking as
# themselves already (the tests, a drill).
who=$(id -un 2>/dev/null || echo "uid $(id -u)")
if [ "$(id -u)" = 0 ] && [ -z "$as_user" ] && id -u toc >/dev/null 2>&1; then
    as_user=toc
fi
[ -n "$as_home" ] || as_home=${HOME:-/}
as_service() {
    if [ "$(id -u)" = 0 ] && [ -n "$as_user" ] && [ "$as_user" != root ]; then
        command -v runuser >/dev/null 2>&1 || return 127
        runuser -u "$as_user" -- env HOME="$as_home" "$@"
    else
        env HOME="$as_home" "$@"
    fi
}
[ "$(id -u)" = 0 ] && [ -n "$as_user" ] && who=$as_user

remote_ok=0
why=""
if ! as_service test -r "$backup_key" 2>/dev/null; then
    why="no state-sync deploy key $who can read at $backup_key: every sync will fail until it is there"
elif [ -z "$backup_remote" ]; then
    why="no remote to check the key against"
elif ! probe=$(as_service mktemp -d "${TMPDIR:-/tmp}/toc-backup-probe.XXXXXX" 2>/dev/null); then
    why="could not make a scratch repository as $who"
else
    # The sync's own ssh options (toc-state-sync, GIT_SSH_COMMAND).
    ssh_cmd="ssh -i $backup_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
    if as_service git -C "$probe" init -q 2>/dev/null &&
       as_service git -C "$probe" -c user.name=toc-restore -c user.email=toc-restore@localhost \
           commit -q --allow-empty -m probe 2>/dev/null &&
       out=$(as_service GIT_SSH_COMMAND="$ssh_cmd" \
             git -C "$probe" push --dry-run --quiet "$backup_remote" HEAD:refs/heads/toc-restore-probe 2>&1); then
        remote_ok=1
    else
        why="the deploy key could not push to $backup_remote as $who: $(printf '%s' "${out:-git failed}" | tr '\n' ' ' | cut -c1-200)"
    fi
    as_service rm -rf "$probe" 2>/dev/null || rm -rf "$probe"
fi

# A completed sync since the restore began, by its own receipt.
receipt_value() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -1; }
if [ "$remote_ok" = 1 ] && [ -n "$receipts" ]; then
    done_at=$(receipt_value time "$receipts/last-success")
    case "$done_at" in ''|*[!0-9]*) done_at=0 ;; esac
    pushed=$(receipt_value remote_commit "$receipts/last-success")
    mismatch=""
    if [ "$done_at" -ge "$since" ] && [ "$done_at" -gt 0 ] && [ -n "$state_repo" ] && [ -n "$tree" ]; then
        head=$(as_service git -C "$state_repo" rev-parse HEAD 2>/dev/null)
        branch=$(as_service git -C "$state_repo" rev-parse --abbrev-ref HEAD 2>/dev/null)
        there=$(as_service git -C "$state_repo" ls-remote origin "refs/heads/$branch" 2>/dev/null | cut -f1)
        if [ -z "$pushed" ] || [ "$pushed" != "$head" ]; then
            mismatch="the receipt's commit (${pushed:-none}) is not the sync's clone (${head:-unreadable})"
        elif [ "$there" != "$pushed" ]; then
            mismatch="the remote's $branch is at ${there:-nothing readable}, not the pushed ${pushed}"
        else
            for d in player gods heroes corpse/live; do
                # git keeps no empty directory: missing on one side is the
                # same as empty on the other.
                files_in() { [ -d "$1" ] && find "$1" -type f ! -path '*/versions/*' | head -1; }
                if [ ! -d "$state_repo/$d" ] || [ ! -d "$tree/$d" ]; then
                    [ -z "$(files_in "$tree/$d")" ] && [ -z "$(files_in "$state_repo/$d")" ] && continue
                    mismatch="the remote's $d is not the restored tree's"
                    break
                fi
                if ! diff -rq -x versions "$tree/$d" "$state_repo/$d" >/dev/null 2>&1; then
                    mismatch="the remote's $d is not the restored tree's"
                    break
                fi
            done
        fi
    fi
    if [ "$done_at" -ge "$since" ] && [ "$done_at" -gt 0 ] && [ -n "$mismatch" ]; then
        echo "   REMOTE BACKUPS: NOT VERIFIED -- a sync finished after the restore, but $mismatch" >&2
        [ "$bad" = 0 ] && bad=3
    elif [ "$done_at" -ge "$since" ] && [ "$done_at" -gt 0 ]; then
        proved=""
        [ -n "$state_repo" ] && [ -n "$tree" ] && proved=", holding the restored state"
        echo "   REMOTE BACKUPS: verified -- push access as $who, and a state sync reached GitHub at $(receipt_value time_utc "$receipts/last-success") ($(printf '%s' "$pushed" | cut -c1-12))$proved"
    else
        attempt="$(receipt_value result "$receipts/last-attempt")"
        [ -n "$attempt" ] && attempt="; the last attempt: $attempt, $(receipt_value reason "$receipts/last-attempt")"
        echo "   REMOTE BACKUPS: NOT VERIFIED -- push access works as $who, but no state sync has reached GitHub since the restore began${attempt}" >&2
        [ "$bad" = 0 ] && bad=3
    fi
elif [ "$remote_ok" = 1 ]; then
    echo "   REMOTE BACKUPS: push access verified as $who -- no completed sync was checked"
else
    echo "   REMOTE BACKUPS: NOT VERIFIED -- $why" >&2
    [ "$bad" = 0 ] && bad=3
fi
exit $bad
