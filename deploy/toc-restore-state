#!/bin/sh
# Lay a checkout's live state -- player gods heroes log corpse -- into a
# game tree, so that the tree afterwards holds exactly what the checkout
# holds and nothing else. toc-restore calls it; it can be run on its own.
#
#   toc-restore-state SRC DST
#
# Review, 2026-11-23: toc-restore copied state into an existing current/
# with `rsync -a` and no --delete, so a restore over a non-empty install
# kept every file the backup did not have -- a character deleted since, a
# corpse that had already ended -- and a stale corpse is made again at
# boot, its gear with it. It also never stopped the game, which would save
# its own characters back over the restored files.
#
# Review, 2026-11-24: the first version moved the old state aside and then
# copied the new into the live directories, so for the length of the copy
# the tree was half laid -- and toc-state-sync.path starts a sync on any
# change there. A sync landing part way copied 11 characters of 12 (under
# the drop guard's 20%) and pushed it, deleting the twelfth from GitHub
# (tests/test_state_sync_receipts.py, reproduced with the real sync). And a
# copy or a move that failed part way had no way back. Now:
#
#   - on the live tree (TOC_RESTORE_LIVE=1) it holds the maintenance lock
#     every other writer defers to (TOC_DEPLOY_LOCK, /run/toc-deploy.lock):
#     toc-state-sync -- from its timer or its path unit -- skips while it is
#     held, toc-auto-deploy waits, and toc-game-recovery neither restarts
#     the game nor turns a stopped timer back on. A caller already holding
#     it says so with TOC_DEPLOY_LOCKED=1. The game must be stopped: it is
#     the one writer the lock does not hold back;
#   - everything is decided before anything is written: a target that
#     already holds state is refused unless TOC_RESTORE_REPLACE=1;
#   - the new state is copied into a staging directory beside the target
#     and compared with the checkout, file for file -- the live tree is not
#     touched until it is whole;
#   - then each directory is swapped in by rename (same filesystem, so a
#     sync never sees half of one), the old one MOVED to
#     <DST>/../pre-restore-<UTC stamp>/, never deleted; a rename that fails
#     puts back everything already swapped.
#
# Review, 2026-11-24 (second): TOC_RESTORE_LIVE defaulted to 0, so the
# standalone use this header advertises swapped state into /srv/toc/current
# with the game and the sync running and no lock held. Now it fails closed:
#
#   - every run is a live one -- the lock taken, the game proved stopped --
#     unless the caller says TOC_RESTORE_LIVE=0, which only toc-restore's
#     staging call does (into a fresh staging directory). The live tree
#     itself (TOC_LIVE_TREE, /srv/toc/current) is always live: asking for
#     TOC_RESTORE_LIVE=0 there is refused;
#   - the aside directory is a new one, never one that exists: a second
#     restore in the same second used to move player/ *into* the first's
#     pre-restore-<stamp>/player/ (and roll back from the wrong place). It
#     is made with mkdir, which fails when the name is taken, and the next
#     name (-2, -3, ...) is tried;
#   - the staging copy is a second copy of the state on the same disk the
#     game saves to: it is not begun unless that disk has room for it and
#     TOC_RESTORE_RESERVE_MB (512) besides, kept for the game's own saves.
#
# backups/ (the game's own archives) is never touched: it is not in git.
# Exit 0 done, 1 failed (the target as it was), 2 something is running or
# the lock is held, or the live tree was asked for without the lock, 3 the
# target holds state and replacing was not asked, 5 not enough free space.
set -eu

SRC=${1:?usage: toc-restore-state SRC DST}
DST=${2:?usage: toc-restore-state SRC DST}
DIRS="player gods heroes log corpse"
STAMP=$(date -u +%Y%m%d-%H%M%S)
PARENT=$(dirname "$DST")
LOCK="${TOC_DEPLOY_LOCK:-/run/toc-deploy.lock}"
LOCK_WAIT="${TOC_RESTORE_LOCK_WAIT:-300}"
LIVE_TREE="${TOC_LIVE_TREE:-/srv/toc/current}"
RESERVE_MB="${TOC_RESTORE_RESERVE_MB:-512}"

# A path with its directories' symlinks resolved, whether or not it exists.
canonical() {
    if [ -d "$1" ]; then (cd "$1" && pwd -P)
    elif [ -d "$(dirname "$1")" ]; then printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd -P)" "$(basename "$1")"
    else printf '%s\n' "$1"
    fi
}
# A directory made new, named $1 or the first free $1-2, $1-3, ...: mkdir
# without -p fails on a name that is taken, so two restores never share one.
new_dir() {
    n=1; p=$1
    while ! mkdir "$p" 2>/dev/null; do
        [ -e "$p" ] || return 1          # not taken: mkdir failed for itself
        n=$((n + 1)); p="$1-$n"
        [ "$n" -le 1000 ] || return 1
    done
    printf '%s\n' "$p"
}

# Games running from a tree that systemd does not know of -- a merc started
# by hand in its area/ (review, 2026-11-24, third: only toc-game.service was
# asked, and a hand-started game saves over a restore just the same). Reads
# /proc (TOC_PROC, for the tests): each process named merc or rom (the
# CMake build) whose working directory is the tree or under it. Prints their pids; nothing where there
# is no /proc to read, which is a limit: such a host is not checked.
games_running_in() {
    proc=${TOC_PROC:-/proc}
    [ -d "$proc" ] || return 0
    tree=$(canonical "$1")
    for p in "$proc"/[0-9]*; do
        # merc from the Makefile, rom from the CMake build (bin/rom): both
        # save into the tree they run in (review, 2026-11-24).
        name=$(cat "$p/comm" 2>/dev/null) || continue
        case "$name" in merc|rom) ;; *) continue ;; esac
        cwd=$(readlink "$p/cwd" 2>/dev/null) || continue
        [ -d "$cwd" ] && cwd=$(cd "$cwd" 2>/dev/null && pwd -P)
        case "$cwd/" in "$tree"/*) printf '%s ' "$(basename "$p")" ;; esac
    done
}

LIVE="${TOC_RESTORE_LIVE:-1}"
if [ "$(canonical "$DST")" = "$(canonical "$LIVE_TREE")" ] && [ "$LIVE" != 1 ]; then
    echo "   refusing: $DST is the live tree; TOC_RESTORE_LIVE=0 is only for a staging" >&2
    echo "   directory. Run it without, under the lock, with the game stopped." >&2
    exit 2
fi

if [ "$LIVE" = 1 ]; then
    running=$(games_running_in "$DST")
    if [ -n "$running" ]; then
        echo "   refusing: a game is running from $DST (merc or rom, pid $running), not under" >&2
        echo "   systemd; it would save over the restore. Stop it first." >&2
        exit 2
    fi
    if [ "${TOC_DEPLOY_LOCKED:-0}" != 1 ]; then
        exec 9>"$LOCK"
        if ! flock -w "$LOCK_WAIT" 9; then
            echo "   refusing: the maintenance lock ($LOCK) is still held after ${LOCK_WAIT}s -- a deploy?" >&2
            exit 2
        fi
    fi
    if command -v systemctl >/dev/null 2>&1 &&
       systemctl is-active --quiet toc-game.service 2>/dev/null; then
        echo "   refusing: toc-game.service is running and would save over the restore." >&2
        echo "   stop it first (toc-restore stops it itself, under the lock)." >&2
        exit 2
    fi
fi

present=""
for d in $DIRS; do
    if [ -d "$DST/$d" ] && [ -n "$(ls -A "$DST/$d" 2>/dev/null)" ]; then
        present="$present $d"
    fi
done
aside="$PARENT/pre-restore-$STAMP"      # the name it will have if it is free
if [ -n "$present" ] && [ "${TOC_RESTORE_REPLACE:-0}" != 1 ]; then
    echo "   refusing: $DST already holds state:$present" >&2
    echo "   A restore over it would keep files the backup does not have (a" >&2
    echo "   character deleted since, a corpse that has ended). To replace it," >&2
    echo "   set TOC_RESTORE_REPLACE=1: it is moved to $aside, not deleted." >&2
    exit 3
fi

# --- room: the staged copy and the reserve, or nothing is begun ---
mkdir -p "$PARENT"
if [ "${TOC_RESTORE_SPACE_CHECK:-1}" != 0 ]; then
    need=0
    for d in $DIRS; do
        [ -d "$SRC/$d" ] || continue
        k=$(du -sk "$SRC/$d" 2>/dev/null | awk '{print $1}')
        need=$((need + ${k:-0}))
    done
    free=$(df -Pk "$PARENT" 2>/dev/null | awk 'NR == 2 {print $4}')
    case "$free" in
        ''|*[!0-9]*)
            echo "   refusing: cannot tell the free space at $PARENT; nothing was written" >&2
            echo "   (TOC_RESTORE_SPACE_CHECK=0 skips the check, at your own risk)" >&2
            exit 5 ;;
        *)
            want=$((need + RESERVE_MB * 1024))
            if [ "$free" -lt "$want" ]; then
                echo "   refusing: the staged state needs ${need}K and ${RESERVE_MB}M is kept free" >&2
                echo "   for the game's own saves; $PARENT has ${free}K free. Nothing was written." >&2
                exit 5
            fi ;;
    esac
fi

# --- stage: the whole new state, copied and proven, beside the target ---
stage="$PARENT/.$(basename "$DST").state-stage-$STAMP-$$"
rm -rf "$stage"
mkdir -p "$stage"
discard() { rm -rf "$stage"; }
for d in $DIRS; do
    [ -d "$SRC/$d" ] || continue
    if ! rsync -a "$SRC/$d/" "$stage/$d/"; then
        echo "   copying $d into the staging directory failed; $DST is as it was" >&2
        discard; exit 1
    fi
done
for d in $DIRS; do
    [ -d "$SRC/$d" ] || continue
    if ! diff -rq "$SRC/$d" "$stage/$d" >/dev/null 2>&1; then
        echo "   the staged $d does not match the checkout; $DST is as it was:" >&2
        diff -rq "$SRC/$d" "$stage/$d" 2>&1 | head -5 >&2
        discard; exit 1
    fi
done

# --- swap: rename each directory in, keeping the old; undo on any failure ---
mkdir -p "$DST"
moved=""
placed=""
undo() {
    for d in $placed; do
        mv "$DST/$d" "$stage/$d" 2>/dev/null || rm -rf "$DST/$d"
    done
    for d in $moved; do
        mv "$aside/$d" "$DST/$d" || echo "   could not put $d back: it is at $aside/$d" >&2
    done
    discard
    [ -n "$made_aside" ] && rmdir "$aside" 2>/dev/null || true
}
made_aside=""
for d in $DIRS; do
    if [ -e "$DST/$d" ]; then
        if [ -z "$made_aside" ]; then
            if ! aside=$(new_dir "$PARENT/pre-restore-$STAMP"); then
                echo "   could not make a directory to move the old state aside into" >&2
                undo; exit 1
            fi
            made_aside=1
        fi
        if [ -e "$aside/$d" ] || ! mv "$DST/$d" "$aside/$d"; then
            echo "   moving the old $d aside failed; putting back what was swapped" >&2
            undo; exit 1
        fi
        moved="$moved $d"
    fi
    if [ -d "$stage/$d" ]; then
        if ! mv "$stage/$d" "$DST/$d"; then
            echo "   moving the new $d in failed; putting back what was swapped" >&2
            undo; exit 1
        fi
        placed="$placed $d"
    fi
done
rm -rf "$stage"
mkdir -p "$DST/corpse" "$DST/heroes" "$DST/backups"
[ -n "$moved" ] && echo "   moved the existing$moved aside to $aside (nothing deleted)"
echo "   state laid down and compared with the checkout: $(find "$DST/player" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d " ") characters"
