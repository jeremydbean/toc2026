[Unit]
Description=Push live player state to GitHub
Documentation=https://github.com/jeremydbean/toc2026/blob/main/wiki/disaster-recovery.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=toc
Group=toc
Environment=HOME=/srv/toc
# A save starts this within a second (toc-state-sync.path); a tick saves
# every playing character at once, so wait for the burst to land and send
# it as one run. Saves landing during a run do not start another -- the
# path unit sees nothing while this is active -- so the timer, every
# minute, picks them up.
ExecStartPre=/bin/sleep 3
# /run is root-owned; this one is ours, and systemd cleans it up.
RuntimeDirectory=toc-state-sync
ExecStart=/usr/local/sbin/toc-state-sync
# The receipts (last-attempt, last-success) that toc-state-sync-check and
# the operations summary read. A failure is a failure (review, 2026-11-23:
# SuccessExitStatus=0 1 made every failed run read "success"); the timer
# fires again five minutes later whatever this run's result was.
StateDirectory=toc-state-sync
StateDirectoryMode=0750
Environment=TOC_SYNC_STATE_DIR=/var/lib/toc-state-sync
# The private plaintext mirror (owner, 2026-11-23): the same commit, pushed
# after the public one is verified, with its own deploy key
# (/srv/toc/.ssh/id_ed25519_github_mirror, toc's, 0600). Best effort; its
# receipt is $TOC_SYNC_STATE_DIR/mirror.
Environment=MIRROR_REMOTE=git@github.com:jeremydbean/toc2026-player-backups.git
TimeoutStartSec=600
