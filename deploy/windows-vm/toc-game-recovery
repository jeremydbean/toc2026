#!/bin/bash
# Recover toc-game when systemd has given up on it.
#
# systemd's own Restart=always handles an ordinary crash, and WatchdogSec
# handles a hang. Neither covers the case this script exists for: once
# StartLimitBurst starts happen inside StartLimitIntervalSec, the unit enters
# `failed` and systemd stops trying entirely. Without something outside
# systemd the game then stays down until a human notices.
#
# Escalation is deliberately staged, because a failing start is usually
# transient and rebuilding is not free:
#
#   1. clear the failure and start the service again
#   2. if that keeps failing, rebuild the commit that is live (the one
#      toc-deploy recorded in log/deployed-commit) in the build tree,
#      validate it, and only install a binary that actually passed. Never
#      the tip of main: that may be code CI has not passed, and recovering
#      a down game is not a reason to ship it (redesign, 2026-10-25). A
#      newer, tested commit reaches a down game through toc-auto-deploy,
#      which deploys when nothing is listening.
#   3. if the freshly built binary also fails, roll the old one back
#
# Player data is never touched. Only the compiled binary is ever replaced,
# and the previous one is always kept.
set -eu

SERVICE=${TOC_SERVICE:-toc-game.service}
LIVE_ROOT=${TOC_LIVE_ROOT:-/srv/toc/current}
BUILD_ROOT=${TOC_BUILD_ROOT:-/srv/toc/build}
STATE_DIR=${TOC_STATE_DIR:-/var/lib/toc}
BACKUP_DIR=${TOC_BACKUP_DIR:-/var/backups/toc}
REPO_URL=${TOC_REPO_URL:-https://github.com/jeremydbean/toc2026}
REPO_BRANCH=${TOC_REPO_BRANCH:-main}
MAINTENANCE_MARKER=${TOC_MAINTENANCE_MARKER:-/etc/toc/maintenance}
# Ownership the game runs as. Overridable so the scenarios can run on a
# machine without a toc account, such as a CI runner.
OWNER=${TOC_OWNER:-toc}
GROUP=${TOC_GROUP:-toc}
# install(1) can only set ownership as root, and only to an account that
# exists. Getting the binary back in place matters more than its owner, so
# drop the flags rather than fail the whole recovery when either is untrue.
own_flags=()
# (A literal "\n" stood where this line break is, so the test never
# passed and merc was installed root:root -- audit, 2026-10-22.)
if [ "$(id -u)" -eq 0 ] && id -u "$OWNER" >/dev/null 2>&1 \
   && getent group "$GROUP" >/dev/null 2>&1; then
    own_flags=(-o "$OWNER" -g "$GROUP")
fi

COUNT_FILE="$STATE_DIR/recovery-failures"
LAST_REBUILD_FILE="$STATE_DIR/recovery-last-rebuild"
DEPLOYED_COMMIT_FILE="$STATE_DIR/deployed-commit"
LOCK_FILE=${TOC_RECOVERY_LOCK:-/run/lock/toc-game-recovery.lock}
# toc-deploy's and toc-auto-deploy's lock: they stop the game on purpose
# and build in the same tree this resets.
DEPLOY_LOCK=${TOC_DEPLOY_LOCK:-/run/toc-deploy.lock}

GAME_PORT=${TOC_GAME_PORT:-9000}
START_GRACE=${TOC_START_GRACE_SEC:-20}
# Plain restarts to try before considering a rebuild.
MAX_PLAIN_ATTEMPTS=${TOC_MAX_PLAIN_ATTEMPTS:-3}
# Never rebuild more often than this, so a genuinely broken upstream cannot
# turn into a build loop that pins the CPU of a 2-vCPU VM.
REBUILD_COOLDOWN=${TOC_REBUILD_COOLDOWN_SEC:-3600}
# A build needs room; refuse rather than fill the disk.
MIN_FREE_MB=${TOC_MIN_FREE_MB:-2048}

log() { echo "toc-game-recovery: $*"; }

now() { date +%s; }

read_number()
{
    if [ -r "$1" ]; then
        value="$(cat "$1" 2>/dev/null || echo 0)"
        case "$value" in
            ''|*[!0-9]*) echo 0 ;;
            *) echo "$value" ;;
        esac
    else
        echo 0
    fi
}

# systemd says "active" as soon as the process is up; the game is only really
# back when it answers on its port.
game_answers()
{
    # bash, not sh: /dev/tcp is a bash feature and dash does not have it.
    timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/$GAME_PORT" 2>/dev/null
}

healthy()
{
    systemctl is-active --quiet "$SERVICE" && game_answers
}

install -d -m 0755 "$STATE_DIR"

# How the last run ended, for toc-ops-summary (review, 2026-11-23: a
# recovery that kept failing was visible only in the journal). Every way out
# writes it: the exit status and the run's last line of output.
RECOVERY_LAST="$STATE_DIR/recovery-last"
last_said="started"
log() { echo "toc-game-recovery: $*"; last_said=$(printf '%s' "$*" | tr '\t\n' '  ' | cut -c1-200); }
record_last() {
    printf 'time=%s\nexit=%s\nsaid=%s\n' "$(date +%s)" "$1" "$last_said" \
        > "$RECOVERY_LAST.tmp" 2>/dev/null && mv -f "$RECOVERY_LAST.tmp" "$RECOVERY_LAST" 2>/dev/null
    return 0
}
trap 'record_last $?' EXIT

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "another recovery run holds the lock; skipping."
    exit 0
fi

# A deploy stops the game on purpose, and builds in $BUILD_ROOT. Taking
# only this script's own lock let a run that fell inside one read the
# stopped game as a failure, reset and clean the tree the deploy was
# building in and install a binary over the one being copied (audit,
# 2026-10-21). Held for the whole run, after our own lock and never
# waited for, so the two scripts cannot deadlock; the game's state is
# only judged once it is held.
exec 8>"$DEPLOY_LOCK"
if ! flock -n 8; then
    log "a deploy is running; leaving the game to it."
    exit 0
fi

# Deliberate downtime is not a failure.
if [ -e "$MAINTENANCE_MARKER" ]; then
    log "maintenance marker present; leaving the service alone."
    exit 0
fi

# ------------------------------------------------- the services beside it
# Owner, 2026-11-22: "build self healing ability into these required tasks
# and processes that restart them". The game is not the only thing that
# must stay up: the website, and the timers that save players to GitHub,
# watch that, deploy, and the website's maintenance helper. Every run,
# before the game is judged:
#
#   * a timer or path unit that is enabled but not active is started
#     again (a unit disabled on purpose, or not installed here, is left);
#   * the website, enabled, is started if it is not running, and restarted
#     if it is running but has not answered its health check on
#     WEB_FAILS_BEFORE_RESTART runs in a row (a hung process).
#
# Held to the same rules as the game: never during a deploy (the lock
# above) or a maintenance window (the marker above).
KEEP_UNITS=${TOC_KEEP_UNITS:-"toc-state-sync.timer toc-state-sync-check.timer toc-auto-deploy.timer toc-host-action.path toc-player-backup.timer toc-daily-backup.timer caddy.service"}
WEB_SERVICE=${TOC_WEB_SERVICE:-toc-web.service}
WEB_HEALTH_URL=${TOC_WEB_HEALTH_URL:-http://127.0.0.1:9001/api/health}
WEB_FAIL_FILE="$STATE_DIR/web-health-failures"
WEB_FAILS_BEFORE_RESTART=${TOC_WEB_FAILS_BEFORE_RESTART:-2}

web_answers()
{
    curl --fail --silent --max-time 5 --output /dev/null "$WEB_HEALTH_URL" 2>/dev/null
}

keep_services_up()
{
    for unit in $KEEP_UNITS; do
        [ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" = enabled ] || continue
        systemctl is-active --quiet "$unit" && continue
        log "$unit is enabled but $(systemctl is-active "$unit" 2>/dev/null || true); starting it."
        systemctl reset-failed "$unit" 2>/dev/null || true
        systemctl start "$unit" 2>/dev/null || log "could not start $unit."
    done

    [ "$(systemctl is-enabled "$WEB_SERVICE" 2>/dev/null || true)" = enabled ] || return 0
    if ! systemctl is-active --quiet "$WEB_SERVICE"; then
        log "$WEB_SERVICE is not running; starting it."
        systemctl reset-failed "$WEB_SERVICE" 2>/dev/null || true
        systemctl start "$WEB_SERVICE" 2>/dev/null || log "could not start $WEB_SERVICE."
        echo 0 > "$WEB_FAIL_FILE"
        return 0
    fi
    if web_answers; then
        [ "$(read_number "$WEB_FAIL_FILE")" -eq 0 ] || echo 0 > "$WEB_FAIL_FILE"
        return 0
    fi
    web_fails=$(( $(read_number "$WEB_FAIL_FILE") + 1 ))
    if [ "$web_fails" -lt "$WEB_FAILS_BEFORE_RESTART" ]; then
        echo "$web_fails" > "$WEB_FAIL_FILE"
        log "$WEB_SERVICE did not answer its health check; looking again next run."
        return 0
    fi
    log "$WEB_SERVICE has not answered on $web_fails runs in a row; restarting it."
    systemctl restart "$WEB_SERVICE" 2>/dev/null || log "could not restart $WEB_SERVICE."
    echo 0 > "$WEB_FAIL_FILE"
}

# ----------------------------------------------------------------- the disk
# 2026-11-22: the disk filled. The state sync's git clone and the build
# tree had grown to 43 GB of loose objects between them (the repository
# is about 100 MB on GitHub), the sync failed for a day, and every save
# the game made was at risk. The scripts keep their own clones packed now;
# this is the net under them. When free space or free inodes fall below
# DISK_LOW_MB / DISK_LOW_INODE_PCT, at most once in JANITOR_GAP, it clears
# only what can be made again, cheapest first:
#
#   the journal, to JOURNAL_KEEP; apt's package cache; both git copies
#   packed (each by its owner, the sync's under the sync's own lock);
#   the old tar rollbacks toc-deploy stopped making on 2026-10-25; all but
#   the newest clone a repair set aside; all but the newest BINARY_KEEP
#   binaries a rebuild saved.
#
# Never a player file, a snapshot, a corpse, the game's backups/ or a log
# of the game's. Every run that clears anything says what it freed to the
# journal and to staff in the game (WIZINFO); if the disk is still low
# after, it says that needs a person.
DISK_PATH=${TOC_DISK_PATH:-/srv/toc}
DISK_LOW_MB=${TOC_DISK_LOW_MB:-6144}
DISK_LOW_INODE_PCT=${TOC_DISK_LOW_INODE_PCT:-10}
JANITOR_GAP=${TOC_JANITOR_GAP_SEC:-1800}
JANITOR_FILE="$STATE_DIR/disk-janitor-last"
JOURNAL_KEEP=${TOC_JOURNAL_KEEP:-200M}
STATE_REPO=${TOC_STATE_REPO:-/srv/toc/state-repo}
SYNC_USER=${TOC_SYNC_USER:-toc}
SYNC_LOCK=${TOC_SYNC_LOCK:-/run/toc-state-sync/lock}
ROLLBACK_DIR=${TOC_ROLLBACK_DIR:-/srv/toc}
BINARY_KEEP=${TOC_BINARY_KEEP:-5}
QUEUE=${TOC_QUEUE:-$LIVE_ROOT/area/webadmin.queue}

disk_free_mb()
{
    df -Pm "$DISK_PATH" 2>/dev/null | awk 'NR==2 {print $4}'
}

disk_free_inode_pct()
{
    df -Pi "$DISK_PATH" 2>/dev/null | awk 'NR==2 {gsub("%", "", $5); if ($5 ~ /^[0-9]+$/) print 100 - $5}'
}

tell_staff()
{
    [ -f "$QUEUE" ] && [ -w "$QUEUE" ] || return 0
    python3 -c 'import fcntl, sys
with open(sys.argv[1], "a", encoding="ascii", errors="replace") as f:
    fcntl.lockf(f.fileno(), fcntl.LOCK_EX)
    f.write(sys.argv[2] + "\n")' "$QUEUE" "wizinfo|60|$1" 2>/dev/null || true
}

pack_repo()   # DIR USER
{
    [ -d "$1/.git" ] || return 0
    rm -f "$1/.git/gc.log"
    # An hour's grace: an object written a moment ago by a fetch or commit
    # this run does not hold the lock of is never pruned from under it.
    if [ "$2" = root ] || [ "$(id -u)" -ne 0 ]; then
        timeout 1800 git -c safe.directory="$1" -C "$1" gc --quiet --prune=1.hour.ago 2>/dev/null
    else
        timeout 1800 runuser -u "$2" -- git -C "$1" gc --quiet --prune=1.hour.ago 2>/dev/null
    fi
}

GAME_ARCHIVES=${TOC_GAME_ARCHIVES:-$LIVE_ROOT/backups}
GAME_ARCHIVE_KEEP=${TOC_BACKUP_KEEP:-6}
GAME_ARCHIVE_DAYS=${TOC_BACKUP_DAYS:-30}

keep_disk_clear()
{
    free_mb=$(disk_free_mb)
    inode_pct=$(disk_free_inode_pct)
    case "$free_mb" in ''|*[!0-9]*) return 0 ;; esac
    case "$inode_pct" in ''|*[!0-9]*) inode_pct=100 ;; esac
    if [ "$free_mb" -ge "$DISK_LOW_MB" ] && [ "$inode_pct" -ge "$DISK_LOW_INODE_PCT" ]; then
        return 0
    fi
    last=$(read_number "$JANITOR_FILE")
    [ $(( $(now) - last )) -ge "$JANITOR_GAP" ] || return 0
    now > "$JANITOR_FILE"
    log "the disk is low (${free_mb} MB, ${inode_pct}% of inodes free); clearing what can be made again."
    done_what=""

    journalctl --vacuum-size="$JOURNAL_KEEP" >/dev/null 2>&1 && done_what="$done_what journal"
    if command -v apt-get >/dev/null 2>&1; then
        apt-get clean >/dev/null 2>&1 && done_what="$done_what apt-cache"
    fi
    # The sync's clone under the sync's own lock: the lock's directory is
    # the sync's RuntimeDirectory and exists only while a run is going,
    # and such a run packs its clone itself.
    if [ -d "$STATE_REPO/.git" ]; then
        if [ -e "$SYNC_LOCK" ]; then
            ( exec 7<"$SYNC_LOCK" && flock -n 7 && pack_repo "$STATE_REPO" "$SYNC_USER" ) &&
                done_what="$done_what sync-clone"
        else
            pack_repo "$STATE_REPO" "$SYNC_USER" && done_what="$done_what sync-clone"
        fi
    fi
    # The build tree under the deploy lock this run already holds.
    pack_repo "$BUILD_ROOT" root && done_what="$done_what build-tree"
    tars=0
    for f in "$ROLLBACK_DIR"/rollback-code-*.tgz; do
        [ -f "$f" ] && rm -f -- "$f" && tars=$((tars + 1))
    done
    [ "$tars" -eq 0 ] || done_what="$done_what old-rollback-tars($tars)"
    ls -1d "$STATE_REPO".broken-* "$STATE_REPO".corrupt-* 2>/dev/null | sort -r | tail -n +2 |
        while read -r old; do rm -rf -- "$old"; done
    ls -1 "$BACKUP_DIR"/merc-rollback-* 2>/dev/null | sort -r | tail -n +$((BINARY_KEEP + 1)) |
        while read -r old; do rm -f -- "$old"; done
    # The game's own archives, by the game's own rule (src/update.c's
    # backup_script; review, 2026-11-23): past the newest $GAME_ARCHIVE_KEEP
    # and older than $GAME_ARCHIVE_DAYS days, and only while no backup job
    # holds the archive lock. Never the newest few, never player/.
    if [ -d "$GAME_ARCHIVES" ] && [ -e "$GAME_ARCHIVES/.backup.flock" ]; then
        expired=$(
            exec 6<"$GAME_ARCHIVES/.backup.flock" && flock -n 6 || exit 0
            n=0
            for f in $(ls -1t "$GAME_ARCHIVES" | grep '\.tar\.gz$' | tail -n +$((GAME_ARCHIVE_KEEP + 1))); do
                if [ -n "$(find "$GAME_ARCHIVES/$f" -mtime +"$GAME_ARCHIVE_DAYS" 2>/dev/null)" ]; then
                    rm -f -- "$GAME_ARCHIVES/$f" && n=$((n + 1))
                fi
            done
            echo "$n")
        case "$expired" in ''|0) ;; *) done_what="$done_what old-game-archives($expired)" ;; esac
    fi

    after_mb=$(disk_free_mb)
    case "$after_mb" in ''|*[!0-9]*) after_mb=$free_mb ;; esac
    freed=$(( after_mb - free_mb ))
    log "cleared:${done_what:- nothing}; freed ${freed} MB, ${after_mb} MB free now."
    if [ "$after_mb" -lt "$DISK_LOW_MB" ]; then
        log "the disk is still low after clearing; this needs a person."
        tell_staff "The server's disk was low; the recovery timer cleared what it could (${freed} MB) and ${after_mb} MB is free. That is still low and needs a person: Server maintenance > Show the host's health."
    else
        tell_staff "The server's disk was low (${free_mb} MB free); the recovery timer cleared what can be made again and ${after_mb} MB is free now."
    fi
}

keep_services_up || true
keep_disk_clear || true

if [ -e "$LIVE_ROOT/area/shutdown.txt" ]; then
    log "in-game shutdown marker present; leaving the service alone."
    exit 0
fi

if healthy; then
    # Clear the history so an unrelated failure months later starts fresh.
    [ "$(read_number "$COUNT_FILE")" -eq 0 ] || echo 0 > "$COUNT_FILE"
    exit 0
fi

failures=$(( $(read_number "$COUNT_FILE") + 1 ))
echo "$failures" > "$COUNT_FILE"
log "service is not answering (consecutive recovery attempts: $failures)."

# ---------------------------------------------------------------- stage one
log "clearing any failed state and starting $SERVICE."
systemctl reset-failed "$SERVICE" 2>/dev/null || true
systemctl start "$SERVICE" 2>/dev/null || true
sleep "$START_GRACE"

if healthy; then
    log "recovered by restarting; no rebuild needed."
    echo 0 > "$COUNT_FILE"
    exit 0
fi

if [ "$failures" -lt "$MAX_PLAIN_ATTEMPTS" ]; then
    log "still down; will try a plain restart again before rebuilding."
    exit 0
fi

# ---------------------------------------------------------------- stage two
last_rebuild=$(read_number "$LAST_REBUILD_FILE")
age=$(( $(now) - last_rebuild ))
if [ "$last_rebuild" -gt 0 ] && [ "$age" -lt "$REBUILD_COOLDOWN" ]; then
    log "rebuild attempted ${age}s ago; cooling down for $REBUILD_COOLDOWN s."
    exit 0
fi

free_mb=$(df -Pm "$(dirname "$BUILD_ROOT")" | awk 'NR==2 {print $4}')
if [ "${free_mb:-0}" -lt "$MIN_FREE_MB" ]; then
    log "only ${free_mb}MB free; refusing to build. Free space and retry."
    exit 1
fi

live_line=$(cat "$LIVE_ROOT/log/deployed-commit" 2>/dev/null || true)
live_ref=${live_line%% *}
case "$live_ref" in
    unknown)
        # toc-deploy's rollback writes this when the code it put back has
        # no recorded identity (review, 2026-10-26): there is no commit to
        # rebuild, and guessing one would mix two commits in one tree.
        log "the live code is unknown ($live_line);"
        log "not building anything. This needs a human: toc-deploy by hand."
        exit 1 ;;
    ''|*[!0-9a-f]*)
        log "no record of the live commit in $LIVE_ROOT/log/deployed-commit;"
        log "not building anything CI has not passed. This needs a human."
        exit 1 ;;
esac
# The tree names its own code (.code-revision, written by toc-deploy). A
# deploy that came back unhealthy and was left for a person (toc-deploy's
# exit 12) holds new code under the old record; building the recorded
# commit's binary into it is a mixture of two commits, not a recovery.
# A tree from before identities were kept has no file and is trusted to
# the record, as it always was.
code_ref=$(cut -d' ' -f1 "$LIVE_ROOT/.code-revision" 2>/dev/null || true)
if [ -n "$code_ref" ]; then
    case "$code_ref" in
        "$live_ref"*) ;;
        *)
            log "the live tree holds $code_ref but the record says $live_ref;"
            log "not building one commit's binary into another's tree. This needs"
            log "a human: toc-deploy --rollback, or a deploy."
            exit 1 ;;
    esac
fi
# A binary put in place here is the same commit's, so the tree keeps its
# name; its checksum changes with it, or toc-deploy would read the next
# snapshot of this tree as unknown.
note_binary()
{
    [ -n "$code_ref" ] || return 0
    sum=$(sha256sum "$LIVE_ROOT/merc" 2>/dev/null | cut -d' ' -f1)
    printf '%s %s\n' "$code_ref" "$sum" > "$LIVE_ROOT/.code-revision.tmp" &&
        mv -f "$LIVE_ROOT/.code-revision.tmp" "$LIVE_ROOT/.code-revision" || true
}
log "restarts are not working; rebuilding the live commit $live_ref."
echo "$(now)" > "$LAST_REBUILD_FILE"

if [ -d "$BUILD_ROOT/.git" ]; then
    timeout 300 git -C "$BUILD_ROOT" fetch --prune origin "$REPO_BRANCH" \
        || { log "fetch failed; keeping the current binary."; exit 1; }
else
    rm -rf "$BUILD_ROOT"
    timeout 300 git clone --branch "$REPO_BRANCH" "$REPO_URL" "$BUILD_ROOT" \
        || { log "clone failed; keeping the current binary."; exit 1; }
fi
git -C "$BUILD_ROOT" reset --hard "$live_ref" >/dev/null \
    || { log "cannot check out $live_ref; keeping the current binary."; exit 1; }
git -C "$BUILD_ROOT" clean -fdx >/dev/null

new_commit="$(git -C "$BUILD_ROOT" rev-parse --short HEAD)"
old_commit="$(cat "$DEPLOYED_COMMIT_FILE" 2>/dev/null || echo unknown)"
log "building $new_commit (currently deployed: $old_commit)."

if ! make -C "$BUILD_ROOT" clean >/dev/null 2>&1; then
    log "make clean failed; continuing anyway."
fi

if ! timeout 1800 make -C "$BUILD_ROOT" -j"$(nproc)" >/dev/null 2>&1; then
    log "build of $new_commit FAILED; keeping the current binary."
    exit 1
fi

# Prove the new binary can load the world before it goes anywhere near the
# live tree. This runs against the build tree's own area files.
if ! ( cd "$BUILD_ROOT/area" && timeout 300 ../merc --check-area >/dev/null 2>&1 ); then
    log "$new_commit built but failed --check-area; keeping the current binary."
    exit 1
fi

log "$new_commit built and validated; installing."
rollback="$BACKUP_DIR/merc-rollback-$(date -u +%Y%m%dT%H%M%SZ)"
install -d -m 0700 "$BACKUP_DIR"
if [ -f "$LIVE_ROOT/merc" ]; then
    cp -p "$LIVE_ROOT/merc" "$rollback"
    log "previous binary saved as $rollback."
fi

install ${own_flags[@]+"${own_flags[@]}"} -m 0755 "$BUILD_ROOT/merc" "$LIVE_ROOT/merc"
note_binary
systemctl reset-failed "$SERVICE" 2>/dev/null || true
systemctl start "$SERVICE" 2>/dev/null || true
sleep "$START_GRACE"

if healthy; then
    log "recovered on $new_commit."
    echo "$new_commit" > "$DEPLOYED_COMMIT_FILE"
    echo 0 > "$COUNT_FILE"
    exit 0
fi

# ------------------------------------------------------------- stage three
log "$new_commit also fails to run; rolling the previous binary back."
if [ -f "$rollback" ]; then
    install ${own_flags[@]+"${own_flags[@]}"} -m 0755 "$rollback" "$LIVE_ROOT/merc"
    note_binary
    systemctl reset-failed "$SERVICE" 2>/dev/null || true
    systemctl start "$SERVICE" 2>/dev/null || true
    sleep "$START_GRACE"
    if healthy; then
        log "rolled back to the previous binary and recovered."
        exit 0
    fi
fi

log "the game is down and neither the new nor the previous binary starts."
log "this needs a human: check journalctl -u $SERVICE."
exit 1
