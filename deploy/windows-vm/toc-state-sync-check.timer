[Unit]
Description=Check the player-state backup every quarter hour

[Timer]
# On the wall clock, two minutes after a sync is due (syncs fall on every
# fifth minute), so the two no longer meet every quarter hour; a monotonic
# timer started by a deploy alongside the sync's did (2026-10-04).
# Persistent= applies only to OnCalendar= timers.
OnCalendar=*-*-* *:07/15:00
OnBootSec=10min
Persistent=true

[Install]
WantedBy=timers.target
