#!/bin/sh
# Notice when the state sync stops working.
#
# The way backups fail is quietly. toc-state-sync could break for any
# number of dull reasons -- a revoked deploy key, a full disk, GitHub
# down, a botched edit -- and nothing about the running game would look
# different. The first anyone would know is the next disaster, which is
# exactly the wrong time to find out.
#
# So: check that the sync ran recently and succeeded, and if it did not,
# say so somewhere a person will see it.
set -eu

UNIT="${UNIT:-toc-state-sync.service}"
MAX_AGE_MIN="${MAX_AGE_MIN:-20}"        # timer is every 5; 20 is four misses
STATE_REPO="${STATE_REPO:-/srv/toc/state-repo}"
MARKER="${MARKER:-/run/toc-state-sync.status}"
# systemd gives the service a RuntimeDirectory; run by hand there is
# none, and a failed marker write must not fail the check itself.
mkdir -p "$(dirname "$MARKER")" 2>/dev/null || true
QUEUE="${QUEUE:-/srv/toc/current/area/webadmin.queue}"
WIZINFO_LEVEL="${WIZINFO_LEVEL:-60}"    # LEVEL_IMMORTAL

# Tell staff who are in the game. A staff character reading this is the
# whole point; an error only journald sees is an error nobody sees. On
# WIZINFO at immortal level, not ANNOUNCE: players can do nothing about a
# backup and should not be told theirs is failing (owner, 2026-10-04).
# Appended under the fcntl lock the game takes while it reads and
# truncates the queue, or a line landing then is lost (as in toc-deploy);
# without python3 the append is plain and best-effort.
tell_staff() {
    [ -f "$QUEUE" ] && [ -w "$QUEUE" ] || return 0
    line="wizinfo|$WIZINFO_LEVEL|$1"
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import fcntl, sys
with open(sys.argv[1], "a", encoding="ascii", errors="replace") as f:
    fcntl.lockf(f.fileno(), fcntl.LOCK_EX)
    f.write(sys.argv[2] + "\n")' "$QUEUE" "$line" 2>/dev/null || true
    else
        printf '%s\n' "$line" >> "$QUEUE" 2>/dev/null || true
    fi
}

# The disk (2026-11-22: it filled -- the sync's and the build tree's git
# copies had grown to 43 GB of loose objects -- and the first anyone knew
# was the sync failing a day later, while every save the game made was at
# risk). Said every check while it is low, as the sync's failure is.
DISK_PATH="${DISK_PATH:-/srv/toc}"
DISK_MIN_FREE_MB="${DISK_MIN_FREE_MB:-4096}"
free_mb=$(df -Pm "$DISK_PATH" 2>/dev/null | awk 'NR==2 {print $4}')
case "$free_mb" in
    ''|*[!0-9]*) ;;
    *)
        if [ "$free_mb" -lt "$DISK_MIN_FREE_MB" ]; then
            echo "DISK NEARLY FULL: ${free_mb} MB free on $DISK_PATH" >&2
            logger -t toc-state-sync -p daemon.err "disk nearly full: ${free_mb} MB free on $DISK_PATH" 2>/dev/null || true
            tell_staff "The server's disk is nearly full: ${free_mb} MB free. Player saves fail when it fills. The website's Server maintenance > Show the host's health says what is using it."
        fi ;;
esac

# Memory (review, 2026-11-22: nothing watched it). A game that leaks is
# killed by the kernel when it runs out and systemd starts it again, so the
# world comes back -- but everybody is cut off without a word and nobody is
# told why. Said while available memory is under a tenth of the total or
# MEM_MIN_AVAIL_MB, whichever is more.
MEMINFO="${MEMINFO:-/proc/meminfo}"
MEM_MIN_AVAIL_MB="${MEM_MIN_AVAIL_MB:-256}"
if [ -r "$MEMINFO" ]; then
    mem=$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {if (t && a != "") print int(t/1024), int(a/1024)}' "$MEMINFO")
    total_mb=${mem% *}
    avail_mb=${mem#* }
    case "$total_mb$avail_mb" in
        ''|*[!0-9]*) ;;
        *)
            floor=$((total_mb / 10))
            [ "$floor" -lt "$MEM_MIN_AVAIL_MB" ] && floor=$MEM_MIN_AVAIL_MB
            if [ "$avail_mb" -lt "$floor" ]; then
                echo "MEMORY LOW: ${avail_mb} of ${total_mb} MB available" >&2
                logger -t toc-state-sync -p daemon.err "memory low: ${avail_mb} of ${total_mb} MB available" 2>/dev/null || true
                tell_staff "The server is low on memory: ${avail_mb} of ${total_mb} MB available. If it runs out the game is killed and restarted, and everyone is cut off. MEMCHECK in game, and Server maintenance > Show the host's health, say what is using it."
            fi ;;
    esac
fi

# A file the sync commits past half GitHub's limit (review, 2026-11-22:
# toc.log had grown to 23 MB and nothing trimmed it). GitHub refuses a push
# holding a file over 100 MB, and then no save reaches GitHub at all. The
# game trims its logs now (src/logtrim.c); this says so if anything else
# grows that way.
BIG_FILE_MB="${BIG_FILE_MB:-50}"
if [ -d "$STATE_REPO" ]; then
    big=$(find "$STATE_REPO" -path "$STATE_REPO/.git" -prune -o -type f -size +"${BIG_FILE_MB}"M -print 2>/dev/null \
          | sed "s|^$STATE_REPO/||" | head -3 | tr '\n' ' ')
    if [ -n "$big" ]; then
        echo "FILES NEAR GITHUB'S LIMIT: $big" >&2
        logger -t toc-state-sync -p daemon.err "files near GitHub's 100 MB limit: $big" 2>/dev/null || true
        tell_staff "A file the backup commits is over ${BIG_FILE_MB} MB (${big% }). GitHub refuses any over 100 MB, and then no save reaches GitHub."
    fi
fi

# A run in progress has no exit time yet -- systemd zeroes it at start --
# which read as "99999 minutes ago" and announced a dead backup. It is not
# rare: a deploy restarts both timers in the same second, and a 5- and a
# 15-minute timer started together meet every quarter hour (2026-10-04).
# A sync takes seconds; wait for it to finish, then judge the result.
tries=0
while [ "$tries" -lt 60 ]; do
    state=$(systemctl show -p ActiveState --value "$UNIT" 2>/dev/null || echo unknown)
    case "$state" in
        activating|deactivating|reloading) sleep 2; tries=$((tries + 1)) ;;
        *) break ;;
    esac
done

# Judge the receipts toc-state-sync writes, never systemd's Result or exit
# time (review, 2026-11-23: the unit took exit 1 for success, and this check
# then called a sync that failed every run healthy). last-success is written
# only when GitHub shows the run's commit; anything this cannot read or
# prove is a problem, never a pass.
SYNC_STATE_DIR="${TOC_SYNC_STATE_DIR:-/var/lib/toc-state-sync}"
now_s=$(date +%s)

# One KEY=VALUE from a receipt; nothing when the file or key is missing.
receipt() {
    [ -r "$SYNC_STATE_DIR/$1" ] || return 0
    sed -n "s/^$2=//p" "$SYNC_STATE_DIR/$1" | head -1 | tr -cd 'A-Za-z0-9 ._:/()=,;<>+-'
}
minutes_since() {
    case "$1" in
        ''|*[!0-9]*) echo unknown ;;
        *) echo $(( (now_s - $1) / 60 )) ;;
    esac
}

problem=""
success_time=$(receipt last-success time)
success_kind=$(receipt last-success kind)
remote_commit=$(receipt last-success remote_commit)
attempt_time=$(receipt last-attempt time)
attempt_result=$(receipt last-attempt result)
attempt_reason=$(receipt last-attempt reason)
age_min=$(minutes_since "$success_time")
attempt_age=$(minutes_since "$attempt_time")

if [ "$age_min" = unknown ]; then
    problem="no verified sync on record ($SYNC_STATE_DIR/last-success missing or unreadable)"
elif [ "$age_min" -gt "$MAX_AGE_MIN" ]; then
    problem="last verified sync was ${age_min} minutes ago"
elif [ "$age_min" -lt -5 ]; then
    problem="last verified sync is dated in the future"
fi
if [ "$attempt_age" = unknown ]; then
    problem="${problem:+$problem; }no sync attempt on record"
elif [ "$attempt_age" -gt "$MAX_AGE_MIN" ]; then
    problem="${problem:+$problem; }no sync has even been tried for ${attempt_age} minutes"
fi
# The drop guard never fixes itself: say so at once, not after 20 minutes.
case "$attempt_result:$attempt_reason" in
    failed:refused*) problem="${problem:+$problem; }$attempt_reason" ;;
esac

# Unpushed commits are the other way this goes wrong: the script runs,
# commits, and cannot push. That leaves the only copy on a disk that
# might be the one about to fail. A count that cannot be read is not zero.
unpushed=unknown
if [ -d "$STATE_REPO/.git" ]; then
    if unpushed=$(git -C "$STATE_REPO" rev-list --count '@{u}..HEAD' 2>/dev/null); then
        [ "$unpushed" -gt 0 ] && \
            problem="${problem:+$problem; }$unpushed commits committed but never pushed"
    else
        unpushed=unknown
        problem="${problem:+$problem; }cannot tell whether the clone holds unpushed commits"
    fi
else
    problem="${problem:+$problem; }no state clone at $STATE_REPO"
fi

detail="age=${age_min}min kind=${success_kind:-none} remote=$(printf '%.12s' "${remote_commit:-none}") last_attempt=${attempt_result:-none} attempt_age=${attempt_age}min unpushed=${unpushed}"
if [ -z "$problem" ]; then
    printf 'ok %s %s\n' "$(date -Is)" "$detail" > "$MARKER" 2>/dev/null || true
    echo "state sync healthy: $detail"
    exit 0
fi

printf 'FAILING %s %s reason=%s problem=%s\n' "$(date -Is)" "$detail" \
    "${attempt_reason:-none}" "$problem" > "$MARKER" 2>/dev/null || true
echo "STATE SYNC IS NOT WORKING: $problem (${attempt_reason:-no reason recorded})" >&2
logger -t toc-state-sync -p daemon.err "state sync is not working: $problem" 2>/dev/null || true

tell_staff "Player-state backup to GitHub is not working ($problem). Saves are still on disk but are not leaving this machine."

exit 1
