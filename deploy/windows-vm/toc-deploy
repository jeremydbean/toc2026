#!/bin/sh
# Bring the running game up to what is on GitHub.
#
# This replaces doing it by hand, which is how area/custom.are went
# missing on 2026-09-29: it is tracked in git *and* listed in
# area.lst, so excluding it as "a runtime file" left the game unable
# to boot. The exclude list below is the one that is actually right,
# and having it in a script means it stays right.
#
#   sudo toc-deploy            # fetch, build, check, install, restart
#   sudo toc-deploy --dry-run  # everything except stopping the game
#   sudo toc-deploy --rollback # the code from the newest snapshot, back
#
# State is never taken from git by this script. player/, gods/, log/
# and the area runtime files belong to the running game; toc-restore
# is the one that puts them back, and only onto a machine that has
# none.
set -eu

BUILD="${BUILD:-/srv/toc/build}"
CURRENT="${CURRENT:-/srv/toc/current}"
BRANCH="${BRANCH:-main}"
# toc-auto-deploy pins the commit CI passed, so a push that lands while
# it waited is not deployed unchecked. By hand it is the branch tip.
REF="${TOC_DEPLOY_REF:-origin/$BRANCH}"
DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

say() { printf '\n== %s\n' "$*"; }

# Append one line to the webadmin queue under the fcntl lock the game and
# the dashboard take: an unlocked append that lands while the game is
# reading the queue and truncating it is lost. Without python3 the append
# is plain and best-effort: the warning matters less than the deploy.
queue_append() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import fcntl, sys
with open(sys.argv[1], "a", encoding="ascii") as f:
    fcntl.lockf(f.fileno(), fcntl.LOCK_EX)
    f.write(sys.argv[2] + "\n")' "$1" "$2" 2>/dev/null
    else
        printf '%s\n' "$2" >> "$1" 2>/dev/null
    fi
}

# How it ended, for toc-auto-deploy's status line: any status but these
# means it stopped before the game was touched.
EXIT_ROLLED_BACK=10        # new code failed; the old is back and healthy
EXIT_ROLLBACK_UNHEALTHY=11 # rolled back, and the old is not healthy either
EXIT_UNHEALTHY=12          # new code not healthy, left for a person
EXIT_RESTARTED=13          # stopped, nothing installed, old code back and healthy
EXIT_RESTART_UNHEALTHY=14  # stopped, nothing installed, and not healthy again

# The probe toc-auto-deploy asks too (deploy/windows-vm/toc-game-probe),
# from the tree being deployed.
GAME_PROBE="${TOC_GAME_PROBE:-$BUILD/deploy/windows-vm/toc-game-probe}"

# Healthy is the dashboard answering and the game itself answering. The
# dashboard's "merc":true is only a TCP connect, and the game binds its
# port before it loads the world (init_socket, then boot_db), so that
# alone passed for a game still booting -- or hung while it did. A count
# of players over MSSP comes from the running game loop; "unknown" or
# "down" is not healthy.
healthy() {
    curl --fail --silent --max-time 3 http://127.0.0.1:9001/api/health |
        grep -q '"merc":true' || return 1
    case "$("$GAME_PROBE" 127.0.0.1 "${MUD_PORT:-9000}" 2>/dev/null)" in
        ''|*[!0-9]*) return 1 ;;
    esac
    return 0
}

# Every .txt under area/ the running game writes. area/*.txt is excluded
# from the copy wholesale, because help and social text files live there
# too and are code; sync_code copies those back by name, and this is the
# list of what must NOT come back -- getting it wrong took the game down
# on 2026-09-29: the loop originally skipped only the four report files,
# so it copied shutdown.txt out of git into the live tree, and
# ExecCondition=test ! -e .../area/shutdown.txt then stopped toc-game
# from starting at all. Every runtime .txt belongs to the running game
# and none of them may be restored from a checkout or a snapshot.
runtime_txt="shutdown.txt ban.txt bugs.txt ideas.txt typos.txt notes.txt
             maxload.txt wizlist.txt offense.txt relics.txt not.txt
             pkilldata.txt dpsboard.txt"

# Copy the code in one tree over another, and nothing the running game
# owns: sync_code SRC DST [rsync options]. It is the install (build tree
# over the live one), the snapshot taken before the stop (live tree into
# a rollback directory) and the rollback (snapshot over the live tree),
# so all three agree on what code is. rsync's --delete never removes an
# excluded path from the destination, so a rollback takes back new code
# files and leaves every player, corpse, note, log and builder's area as
# it is -- the tar archive it replaces held all of area/, runtime files
# included, and extracting it rewound them.
#
# custom.are is excluded here and seeded by the install rather than
# skipped: it is tracked and area.lst loads it, so the game will not boot
# without it -- leaving it out altogether is how it went missing on
# 2026-09-29.
sync_code() {
    src=$1
    dst=$2
    shift 2
    rsync -a --delete "$@" \
      --exclude '.git/' --exclude '/.snapshot-ok' \
      --exclude 'player/' --exclude 'gods/' --exclude 'heroes/' \
      --exclude 'backups/' --exclude 'corpse/' --exclude 'log/' --exclude 'notes/' \
      --exclude 'area/shutdown' --exclude 'area/webadmin.queue' \
      --exclude 'area/oracle.ask' --exclude 'area/oracle.answer' \
      --exclude 'area/oracle.query' --exclude 'area/oracle.queryresult' \
      --exclude 'area/*.txt' \
      --exclude 'area/pkilldata' --exclude 'area/wizlist' --exclude 'area/maxload' \
      --exclude 'area/offense' --exclude 'area/relics' --exclude 'area/not' \
      --exclude 'area/ban' \
      --exclude 'area/*.are.*.bak' --exclude 'area/*.are.*.tmp' \
      --exclude 'area/*.txt.tmp' \
      --exclude 'area/bugs.txt.*' --exclude 'area/typos.txt.*' \
      --exclude 'area/ideas.txt.*' \
      --exclude 'area/built/' --exclude 'area/custom.are' \
      "$src/" "$dst/" || return
    # The three report globs are REPORTS CLEAR's archives
    # (bugs.txt.<stamp>): it renames rather than deletes because they are
    # the only record of what players said, and before they were listed
    # --delete removed them on the next deploy -- all five archives made
    # on 2026-10-01 went that way.
    for f in "$src"/area/*.txt; do
        [ -f "$f" ] || continue
        b=$(basename "$f")
        skip=0
        for r in $runtime_txt; do
            [ "$b" = "$r" ] && { skip=1; break; }
        done
        [ "$skip" = 1 ] && continue
        cp "$f" "$dst/area/$b" || return
    done
}

# The code that was running back, and the game restarted on it. Only the
# code: the snapshot was taken with sync_code's excludes and goes back
# with them, so whatever players did between the snapshot and now --
# saves, corpses, notes, a builder's RSAVE -- stays. Ordinary rollback
# never restores player state; that is PRESTORE's, and toc-restore's in a
# disaster.
rollback() {
    restored=0
    systemctl stop toc-web toc-game || true
    if [ -f "$SNAP/.snapshot-ok" ] && sync_code "$SNAP" "$CURRENT"; then
        restored=1
    else
        echo "   COULD NOT RESTORE $SNAP -- starting what is there" >&2
    fi
    rm -f "$CURRENT/area/shutdown.txt" "$CURRENT/area/shutdown"
    chown -R toc:toc "$CURRENT" || true
    systemctl start toc-game || true
    sleep 8
    systemctl start toc-web || true
    sleep 6
    if [ "$restored" = 1 ] && healthy; then
        echo "   rolled back and healthy" >&2
        exit $EXIT_ROLLED_BACK
    fi
    echo "   NOT HEALTHY AFTER THE ROLLBACK -- toc-game-recovery will keep trying" >&2
    exit $EXIT_ROLLBACK_UNHEALTHY
}

# The code that was running, started again on the files it ran from.
# For a stop that failed part way -- systemd may have stopped the web
# service and not the game, or the reverse: nothing was installed, so
# starting both is the whole of the recovery, and the
# exit status says whether it worked (review, 2026-10-21: a failed stop
# used to end the script under set -e with whatever it had stopped left
# down, reported as "failed before the game was touched").
restart_unchanged() {
    systemctl start toc-game || true
    sleep 8
    systemctl start toc-web || true
    sleep 6
    if healthy; then
        echo "   nothing installed; the running code is back and healthy" >&2
        exit $EXIT_RESTARTED
    fi
    echo "   NOTHING INSTALLED, AND NOT HEALTHY AGAIN -- toc-game-recovery will keep trying" >&2
    exit $EXIT_RESTART_UNHEALTHY
}

# set -e between stopping the game and starting it again used to leave
# it stopped on a half-copied tree -- an rsync that ran out of disk, a
# chown -- with no rollback, because the rollback lived only after the
# health check. Whatever stops the install now rolls it back, by hand or
# not: there is no running game to leave alone.
# disrupted: a stop has been asked for, so the services may be down.
# installing: the snapshot exists and files may have changed.
disrupted=0
installing=0
install_failed() {
    st=$?
    trap - EXIT
    # A second signal must not cut the rollback short: it is the one
    # thing between a killed deploy and a game left down.
    trap '' HUP INT TERM
    if [ "$installing" = 1 ]; then
        installing=0
        echo "   INSTALL FAILED (status $st) after the game was stopped -- rolling back" >&2
        rollback
    fi
    [ "$disrupted" = 1 ] || exit "$st"
    disrupted=0
    echo "   FAILED (status $st) after asking the game to stop -- restarting it" >&2
    restart_unchanged
}
trap install_failed EXIT
# dash runs no EXIT trap for a shell a signal kills, so Ctrl-C, a dropped
# ssh session or a stop of toc-auto-deploy's unit left the game stopped
# on a half-copied tree with no rollback (audit, 2026-10-22). Turning
# each signal into an exit runs the trap above.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# One deploy at a time: the timer's and a desktop session's could
# otherwise meet in the middle of an rsync. toc-auto-deploy takes the
# lock itself and says so, because a second flock on a fresh open of the
# same file would wait on its own parent.
if [ -z "${TOC_DEPLOY_LOCKED:-}" ]; then
    exec 9>"${TOC_DEPLOY_LOCK:-/run/toc-deploy.lock}"
    flock 9
fi

# Put the code back from a snapshot, by hand, after a deploy that was not
# rolled back (exit 12). The snapshot named, or the newest complete one.
if [ "${1:-}" = "--rollback" ]; then
    SNAP="${TOC_ROLLBACK_SNAPSHOT:-}"
    if [ -z "$SNAP" ]; then
        SNAP=$(ls -d "${TOC_ROLLBACK_DIR:-/srv/toc}"/rollback-code-*/.snapshot-ok 2>/dev/null |
            tail -1 || true)
        SNAP=${SNAP%/.snapshot-ok}
    fi
    if [ -z "$SNAP" ] || [ ! -f "$SNAP/.snapshot-ok" ]; then
        echo "   no complete code snapshot to roll back to (${SNAP:-none found})" >&2
        exit 1
    fi
    say "rolling the code back to $SNAP"
    rollback
fi

say "fetching"
before=$(git -C "$BUILD" rev-parse --short HEAD)
# The build tree holds nothing worth keeping, and it dirties itself:
# running --check-area from build/area makes merc write build/log/toc.log,
# which is a tracked file now that the state sync commits logs. A
# merge --ff-only then refuses and every later deploy fails -- the exact
# trap AGENTS.md describes, arriving by a new route. Discard and reset
# rather than merge, because there is never a local change here to lose.
git -C "$BUILD" checkout --quiet -- . 2>/dev/null || true
git -C "$BUILD" fetch --quiet origin "$BRANCH"
git -C "$BUILD" reset --quiet --hard "$REF"
after=$(git -C "$BUILD" rev-parse --short HEAD)
if [ "$before" = "$after" ]; then
    echo "   already at $after"
else
    echo "   $before -> $after"
fi

say "building"
make -C "$BUILD" clean >/dev/null 2>&1 || true
if ! make -C "$BUILD" >/tmp/toc-deploy-build.log 2>&1; then
    echo "   BUILD FAILED -- nothing has been touched. See /tmp/toc-deploy-build.log" >&2
    tail -15 /tmp/toc-deploy-build.log >&2
    exit 1
fi

say "checking the world"
# Not piped into tail: /bin/sh has no pipefail, so the pipe's status was
# tail's and a world that would not load was installed anyway.
if ! ( cd "$BUILD/area" && ../merc --check-area ) >/tmp/toc-deploy-check.log 2>&1; then
    echo "   WORLD CHECK FAILED -- nothing has been touched. See /tmp/toc-deploy-check.log" >&2
    tail -15 /tmp/toc-deploy-check.log >&2
    exit 1
fi
tail -1 /tmp/toc-deploy-check.log

if [ "$DRY" = 1 ]; then
    say "dry run: built and validated, nothing installed"
    exit 0
fi

say "who is online"
token=$(grep -m1 '^WEB_ADMIN_TOKEN=' /etc/toc/web.env 2>/dev/null | cut -d= -f2- || true)
if [ -n "$token" ]; then
    curl -s --max-time 5 http://127.0.0.1:9001/api/admin/status \
        -H "X-Admin-Token: $token" | grep -o '"count":[0-9]*' | head -1 || true
fi
# Somebody being connected is not a reason to hold. The update is
# already built and validated by this point, and holding a validated
# update until the mud happens to be empty is the worse failure --
# the Pi's updater waited up to fifteen minutes and then went ahead
# anyway, which is the same answer taken slowly.
#
# What is owed to whoever is on is a warning and a save, in that
# order, so nobody loses a session to a restart they did not expect.
# `fsave` is do_forcesave, which writes every playing character; the
# game also saves on a clean shutdown, and this is the belt to that
# pair of braces. The queue is polled rather than read on write, so
# each step needs a moment to be picked up before the next one is
# worth sending.
q="$CURRENT/area/webadmin.queue"
if [ -f "$q" ]; then
    queue_append "$q" \
        "announce|Update incoming - saving everyone now, back in under a minute." || true
    sleep 4
    queue_append "$q" "command|fsave" || true
    sleep 6
    queue_append "$q" \
        "announce|Everyone saved. Restarting - reconnect in a moment." || true
    sleep 3
else
    sleep 6
fi

# Nothing is copied without a way back, and the way back is made while
# the game still runs, so the stop is as short as the copy itself. The
# snapshot is a copy of the live code tree (sync_code's view of it); its
# marker is written last, so a snapshot cut short is never rolled back
# to. Unchanged files are hard links into the previous snapshot. A
# snapshot that cannot be made stops the deploy with the game untouched.
say "snapshotting the running code"
ROLLBACK_DIR="${TOC_ROLLBACK_DIR:-/srv/toc}"
stamp=$(date +%Y%m%d-%H%M%S)
SNAP="$ROLLBACK_DIR/rollback-code-$stamp"
prev=$(ls -d "$ROLLBACK_DIR"/rollback-code-*/.snapshot-ok 2>/dev/null | tail -1 || true)
prev=${prev%/.snapshot-ok}
# Two before this one are kept; older ones go.
ls -d "$ROLLBACK_DIR"/rollback-code-*/ 2>/dev/null | sed 's:/$::' | sort | head -n -2 |
    while read -r old; do
        [ "$old" = "$SNAP" ] || rm -rf "$old"
    done
rm -rf "$SNAP"
if ! mkdir -p "$SNAP" ||
   ! sync_code "$CURRENT" "$SNAP" ${prev:+"--link-dest=$prev"} ||
   ! touch "$SNAP/.snapshot-ok"; then
    echo "   COULD NOT SNAPSHOT THE RUNNING CODE -- nothing touched; the game is still running" >&2
    rm -rf "$SNAP"
    exit 1
fi
echo "   $SNAP"

say "installing"
disrupted=1
if ! systemctl stop toc-web toc-game; then
    echo "   COULD NOT STOP THE GAME CLEANLY -- nothing installed, restarting it" >&2
    disrupted=0
    restart_unchanged
fi
installing=1

sync_code "$BUILD" "$CURRENT"
# custom.are is where RSAVE puts the workshop rooms builders make in game
# (BUILDER_AREA_FILE), and the state sync carries it host to git. The
# live copy is the newest; git's is up to one sync behind, more for a
# deploy pinned to an older commit, and copying it over the live one
# threw away whatever was saved since (audit, 2026-10-21). Like built/,
# it is only filled in when the live tree has none. A change to it is
# made in game, not in git: the next sync would overwrite git's anyway.
if [ ! -f "$CURRENT/area/custom.are" ] && [ -f "$BUILD/area/custom.are" ]; then
    cp "$BUILD/area/custom.are" "$CURRENT/area/custom.are"
fi
# area/built/ is what builders made in game (ANEW). The live copy is the
# newest -- git's is up to one state sync behind -- so a deploy never
# writes over it. It only fills in a built file the live tree lacks, as
# after a rebuild from the repository.
if [ -d "$BUILD/area/built" ]; then
    mkdir -p "$CURRENT/area/built"
    rsync -a --ignore-existing "$BUILD/area/built/" "$CURRENT/area/built/"
fi
# Belt and braces: whatever happened above, the game must not find a
# shutdown marker it did not write itself.
rm -f "$CURRENT/area/shutdown.txt" "$CURRENT/area/shutdown"

chown -R toc:toc "$CURRENT"

say "starting"
systemctl start toc-game
sleep 8
systemctl start toc-web
sleep 4
installing=0
disrupted=0
printf '   game=%s web=%s\n' "$(systemctl is-active toc-game)" "$(systemctl is-active toc-web)"

# The game binds its port before it loads the world, and only answers
# MSSP once the loop runs, so give the boot a minute and a half.
n=0
while [ $n -lt 30 ]; do
    if healthy; then
        say "healthy at $after"
        printf '   characters on disk: %s\n' "$(ls "$CURRENT/player" | wc -l)"

        # What is live, for toc-auto-deploy to compare against and for
        # any session to read: log/ is excluded from the rsync above and
        # carried to GitHub by the state sync.
        printf '%s %s\n' "$(git -C "$BUILD" rev-parse HEAD)" \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$CURRENT/log/deployed-commit"
        chown toc:toc "$CURRENT/log/deployed-commit" 2>/dev/null || true

        # Keep the host's copies of these scripts in step with the
        # checkout that just came back healthy. Nothing used to install
        # them, so a fix to this script or to the state sync sat in git
        # while the VM ran the old copy -- which is how, on 2026-10-01,
        # every deploy copied git's benchmark board over the live one.
        # Only from a build that came back healthy, so a broken script
        # cannot replace a working one; install(1) writes a new file, so
        # the copy running now is not touched.
        for s in toc-deploy toc-state-sync toc-state-sync-check toc-game-recovery \
                 toc-auto-deploy toc-game-probe; do
            if [ -f "$BUILD/deploy/windows-vm/$s" ] &&
               ! cmp -s "$BUILD/deploy/windows-vm/$s" "/usr/local/sbin/$s"; then
                install -m 0755 "$BUILD/deploy/windows-vm/$s" "/usr/local/sbin/$s" &&
                    printf '   installed %s\n' "$s"
            fi
        done
        # The auto-deploy timer's units, the same way. A deploy run by the
        # timer reaches this point too, so it must not restart the
        # service it is running inside: enable --now on the timer only.
        units_changed=0
        for u in toc-auto-deploy.service toc-auto-deploy.timer; do
            if [ -f "$BUILD/deploy/windows-vm/$u" ] &&
               ! cmp -s "$BUILD/deploy/windows-vm/$u" "/etc/systemd/system/$u"; then
                install -m 0644 "$BUILD/deploy/windows-vm/$u" "/etc/systemd/system/$u" &&
                    printf '   installed %s\n' "$u" && units_changed=1
            fi
        done
        if [ "$units_changed" = 1 ]; then
            systemctl daemon-reload
            systemctl enable --now toc-auto-deploy.timer >/dev/null 2>&1 || true
        fi
        # The game and dashboard units too. Nothing installed them, so a
        # fix to either sat in git: the dashboard's --log-file pointed at a
        # root-only file for days (2026-10-06). The dashboard restarts on a
        # changed unit -- nobody is playing through it, and a deploy has
        # just restarted it anyway. The game's unit takes effect at its
        # next start rather than costing players a second restart now.
        for u in toc-web.service toc-game.service; do
            if [ -f "$BUILD/deploy/windows-vm/$u" ] &&
               ! cmp -s "$BUILD/deploy/windows-vm/$u" "/etc/systemd/system/$u"; then
                install -m 0644 "$BUILD/deploy/windows-vm/$u" "/etc/systemd/system/$u" &&
                    printf '   installed %s\n' "$u"
                systemctl daemon-reload
                [ "$u" = toc-web.service ] && systemctl restart toc-web
            fi
        done
        exit 0
    fi
    n=$((n + 1)); sleep 3
done

# Unattended (toc-auto-deploy sets this), there is nobody to read the
# rollback line, so do it: the old code goes back -- the code only, never
# player state -- and the game restarts on it. The world was validated before anything was
# stopped, so this is a game that built and loaded and then would not
# come up -- rare, and exactly what nobody should find hours later.
if [ "${TOC_DEPLOY_ROLLBACK:-0}" = 1 ]; then
    echo "   DID NOT COME BACK HEALTHY -- rolling back to the previous code" >&2
    rollback
fi

echo "   DID NOT COME BACK HEALTHY. Roll the code back (and only the code) with:" >&2
echo "   TOC_ROLLBACK_SNAPSHOT=$SNAP $0 --rollback" >&2
exit $EXIT_UNHEALTHY
