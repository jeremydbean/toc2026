#!/bin/sh
# Ship main to the live game on its own, so that a push is a deploy.
#
# Run every ten minutes by toc-auto-deploy.timer (owner, 2026-10-05). A
# cloud session can push to GitHub and nothing else -- it has HTTPS only,
# no SSH and no key -- so the host comes to GitHub instead: it already
# talks to it every five minutes for the state sync. Nothing on the
# server opens to anything new.
#
# It deploys only when all of this holds:
#
#   * main has moved on from what is live ($CURRENT/log/deployed-commit,
#     written by toc-deploy when a deploy comes back healthy);
#   * the difference touches code -- docs, tests and the state sync's own
#     commits never restart the game;
#   * CI vouches for that exact code: the newest Validate run on a push to
#     main, for that commit or one built on it, finished with its
#     deploy-gate job succeeding. deploy-gate is the workflow's own
#     verdict -- every job passed, every test module ran exactly once,
#     nothing skipped unexplained -- so a run that is missing, queued,
#     running, cancelled, failed, or has no deploy-gate job at all (an
#     older workflow, a renamed job) ships nothing. Read from GitHub's
#     public API; if that cannot be reached, nothing ships either. A
#     commit whose message carries [deploy now] skips that wait for its
#     own code only; toc-deploy still refuses one that will not build or
#     whose world will not load;
#     Since 2026-10-25 a run may test less than everything: CI plans what
#     a change needs (scripts/ci/classify.py), and a documentation commit
#     runs the cheap checks. That cannot vouch for code it did not test,
#     because the plan diffs from the last commit CI vouched for, not from
#     its parent: a docs commit on top of code that failed carries that
#     code's full suite, and a run that passes either ran everything since
#     the last vouched-for commit or changed nothing deployable since it.
#     deploy-gate recomputes the plan and refuses one that does not match,
#     so its success means the same thing it always did;
#   * this exact commit has not already been tried and failed, so a bad
#     push restarts the game once, not every ten minutes;
#   * nobody is playing (owner, 2026-10-20: do not reboot while players
#     are on). The game's own count of playing descriptors is read over
#     MSSP (toc-game-probe); while it is above zero the commit is held,
#     not tried, and the next tick looks again. A count nobody can read
#     -- a hung game, a half-started one -- is not zero, and holds the
#     commit the same way; only a game that is not running at all
#     (connection refused) has nobody to protect and is deployed. A
#     deploy by hand (toc-deploy) is the override, and still warns and
#     saves everyone first; so is [deploy with players] in a waiting
#     commit, for a session that can only push (a minute's warning, then
#     the same announce and save).
#
# Then it runs toc-deploy pinned to that commit, so code pushed while it
# was waiting for CI cannot ride along unchecked, with rollback on: an
# unattended deploy that does not come back healthy puts the old code
# back by itself.
#
# Both markers count only on a line of their own in the commit message
# (has_marker). Anywhere in the text, a sentence that merely mentioned
# one was an order: the commit that brought this redesign said "[deploy
# now] and [deploy with players] keep their meanings" in its body, and on
# 2026-10-25 the game was restarted under a player it had been holding
# for. A [deploy now] in prose could as easily have skipped CI.
#
# What it decided last is in $CURRENT/log/auto-deploy.status, and the
# state sync carries log/ to GitHub, so a session that cannot reach the
# host can still read what is live and why.
set -eu

BUILD="${BUILD:-/srv/toc/build}"
CURRENT="${CURRENT:-/srv/toc/current}"
REPO="${TOC_GITHUB_REPO:-jeremydbean/toc2026}"
STATE_DIR="${STATE_DIR:-/var/lib/toc-auto-deploy}"
LOCK="${TOC_DEPLOY_LOCK:-/run/toc-deploy.lock}"
DEPLOY_BIN="${TOC_DEPLOY_BIN:-/usr/local/sbin/toc-deploy}"
MARKER="$CURRENT/log/deployed-commit"
STATUS="$CURRENT/log/auto-deploy.status"
GAME_HOST="${MUD_HOST:-127.0.0.1}"
GAME_PORT="${MUD_PORT:-9000}"
# A command printing the number of players online, "down" or "unknown"
# (see toc-game-probe). Tests point it at a fake. The installed copy is
# preferred; the build tree's -- the live commit's, as toc-deploy left
# it -- stands in until one is installed. The first deploy to bring this
# script is made by the toc-deploy before it, whose install list does not
# name the probe: without the fallback every later count read "unknown"
# and held every deploy for good.
if [ -n "${TOC_PLAYERS_PROBE:-}" ]; then
    PLAYERS_PROBE="$TOC_PLAYERS_PROBE"
elif [ -x /usr/local/sbin/toc-game-probe ]; then
    PLAYERS_PROBE=/usr/local/sbin/toc-game-probe
else
    PLAYERS_PROBE="$BUILD/deploy/windows-vm/toc-game-probe"
fi
# The job whose success, and nothing else, means CI vouches for a commit.
# validate.yml names it; change the two together.
GATE_JOB="${TOC_GATE_JOB:-deploy-gate}"

mkdir -p "$STATE_DIR"

# The build tree belongs to toc and this runs as root, which git refuses
# ("dubious ownership") unless told the directory is safe. By hand that
# comes from root's ~/.gitconfig, but a systemd service has no HOME, so
# the first timer run failed there. Say it here, in the environment, so
# toc-deploy below inherits it too and no account's config is needed.
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0="$BUILD"

# How many descriptors the game has in CON_PLAYING, "down" when nothing
# listens, or "unknown". Anything else the probe says -- or a probe that
# is missing or fails -- is "unknown".
players_online() {
    answer=$("$PLAYERS_PROBE" "$GAME_HOST" "$GAME_PORT" 2>/dev/null) || answer=unknown
    case "$answer" in
        down) echo down ;;
        ''|*[!0-9]*) echo unknown ;;
        *) echo "$answer" ;;
    esac
}

# Whether any commit message read from stdin carries MARKER as a line of
# its own, surrounding blanks aside.
has_marker() {
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -qxF "$1"
}

status() {
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" > "$STATUS.tmp" &&
        mv "$STATUS.tmp" "$STATUS"
    chown toc:toc "$STATUS" 2>/dev/null || true
    echo "$*"
}

# One deploy at a time. A deploy by hand holds this lock too; if one is
# running, the next timer tick looks again.
exec 9>"$LOCK"
if ! flock -n 9; then
    echo "a deploy is already running"
    exit 0
fi

git -C "$BUILD" checkout --quiet -- . 2>/dev/null || true
git -C "$BUILD" fetch --quiet origin main
target=$(git -C "$BUILD" rev-parse origin/main)
short=$(git -C "$BUILD" rev-parse --short "$target")

live=$(cut -d' ' -f1 "$MARKER" 2>/dev/null || true)
if [ -z "$live" ] || ! git -C "$BUILD" cat-file -e "$live^{commit}" 2>/dev/null; then
    status "no record of what is live in $MARKER; run toc-deploy once by hand"
    exit 0
fi
[ "$live" = "$target" ] && exit 0

# Code is everything a deploy carries into the live tree except what the
# running game owns (the state sync's paths, as validate.yml lists them)
# and what never runs there. One list, for every question below.
deployable() {
    git -C "$BUILD" "$@" -- . \
        ':(exclude)player' ':(exclude)gods' ':(exclude)heroes' ':(exclude)log' \
        ':(exclude)corpse' \
        ':(exclude)notes' ':(exclude)wiki' ':(exclude)tests' ':(exclude).github' \
        ':(exclude,glob)**/*.md' \
        ':(exclude,glob)area/notes.txt' ':(exclude,glob)area/bugs.txt*' \
        ':(exclude,glob)area/ideas.txt*' ':(exclude,glob)area/typos.txt*' \
        ':(exclude)area/pkilldata.txt' ':(exclude)area/wizlist.txt' \
        ':(exclude)area/maxload.txt' ':(exclude)area/offense.txt' \
        ':(exclude)area/relics.txt' ':(exclude)area/not.txt' \
        ':(exclude)area/ban.txt' ':(exclude)area/dpsboard.txt' \
        ':(exclude)area/built'
}
changed=$(deployable diff --name-only "$live" "$target")
live_short=$(git -C "$BUILD" rev-parse --short "$live")
if [ -z "$changed" ]; then
    status "live at $live_short; main ($short) differs only in docs, tests or state"
    exit 0
fi

# What is being shipped is the newest commit that changed deployable
# content; the tip above it carries only state, docs and tests. Every
# decision is about that commit (audit, 2026-10-21): the failed-attempt
# record was the tip, so each state sync made a failed payload new again;
# a [deploy now] anywhere in the range passed newer, unchecked code; and
# a green run on an older commit covered code marked [skip ci] after it.
effective=$(deployable log -1 --format=%H "$live..$target")
effective_short=$(git -C "$BUILD" rev-parse --short "$effective")

if [ "$(cat "$STATE_DIR/attempted" 2>/dev/null || true)" = "$effective" ]; then
    exit 0
fi

if git -C "$BUILD" log -1 --format=%B "$effective" | has_marker '[deploy now]'; then
    why="[deploy now] on $effective_short"
else
    # The run that vouches for $effective is the newest Validate run on a
    # push to main for $effective or a commit built on it: a later push
    # cancels the run before it (cancel-in-progress), and its verdict
    # covers everything under it. State syncs carry [skip ci] and start
    # no run, so they are passed over; so is a push that touched only
    # paths validate.yml ignores, simply because GitHub has no run for it.
    # A run for an older commit never counts, however green: it did not
    # test this code.
    candidates=$( { git -C "$BUILD" rev-list --ancestry-path "$effective..$target";
                    echo "$effective"; } |
        while read -r sha; do
            git -C "$BUILD" log -1 --format=%B "$sha" | grep -qF '[skip ci]' || echo "$sha"
        done)
    if [ -z "$candidates" ]; then
        status "code in $effective_short has no CI run after it (marked [skip ci]?); not deploying $short"
        exit 0
    fi
    runs=$(curl -fsS --max-time 20 \
        "https://api.github.com/repos/$REPO/actions/workflows/validate.yml/runs?branch=main&event=push&per_page=100" \
        2>/dev/null) || runs=""
    # Prints "<sha> <run id> <state>", state being the conclusion of a
    # finished run or the status of one still going; "none" when no
    # candidate has a run, "unreachable" when the answer is not JSON.
    run=$(printf '%s' "$runs" | CANDIDATES="$candidates" python3 -c '
import json, os, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    print("- - unreachable"); sys.exit(0)
order = os.environ["CANDIDATES"].split()
best = {}
for r in data.get("workflow_runs", []):
    if r.get("event") != "push" or r.get("head_branch") != "main":
        continue
    if r.get("name") != "Validate" or r.get("head_sha") not in order:
        continue
    seen = best.get(r["head_sha"])
    if seen is None or (r.get("created_at", ""), r.get("run_attempt", 1)) > \
            (seen.get("created_at", ""), seen.get("run_attempt", 1)):
        best[r["head_sha"]] = r
for sha in order:
    r = best.get(sha)
    if r:
        state = r.get("conclusion") if r.get("status") == "completed" else r.get("status")
        print(sha, r.get("id"), state or "unknown"); break
else:
    print("- - none")
' 2>/dev/null) || run="- - unreachable"
    set -- $run
    ci=$1 run_id=$2 verdict=$3
    ci_short=$( [ "$ci" = - ] && echo "$effective_short" || git -C "$BUILD" rev-parse --short "$ci")
    case "$verdict" in
        success)
            # Green is not enough: the gate job must say so. An older
            # workflow has none, and none fails closed.
            gate=$(curl -fsS --max-time 20 \
                "https://api.github.com/repos/$REPO/actions/runs/$run_id/jobs?filter=latest&per_page=100" \
                2>/dev/null | GATE_JOB="$GATE_JOB" python3 -c '
import json, os, sys
try:
    jobs = json.load(sys.stdin).get("jobs", [])
except ValueError:
    print("unreachable"); sys.exit(0)
named = [j for j in jobs if j.get("name") == os.environ["GATE_JOB"]]
if not named:
    print("missing")
else:
    j = named[-1]
    print(j.get("conclusion") if j.get("status") == "completed" else j.get("status") or "unknown")
' 2>/dev/null) || gate=unreachable
            case "$gate" in
                success)
                    why="CI's $GATE_JOB passed on $ci_short" ;;
                unreachable|"")
                    status "waiting: cannot read CI's $GATE_JOB on $ci_short; not deploying $short"
                    exit 0 ;;
                *)
                    status "not deploying $short: CI on $ci_short passed but its $GATE_JOB job is $gate"
                    exit 0 ;;
            esac ;;
        none|queued|in_progress|waiting|pending|requested|unreachable)
            status "waiting for CI on $ci_short ($verdict) before deploying $short"
            exit 0 ;;
        cancelled)
            status "waiting: CI on $ci_short was cancelled; a newer run or a re-run decides $short"
            exit 0 ;;
        *)
            status "not deploying $short: CI on $ci_short says $verdict; push a fix"
            exit 0 ;;
    esac
fi

# Nobody loses a session to an automatic restart: hold the commit while
# anybody is playing -- or while nobody can tell -- and look again next tick. Not recorded as attempted,
# so it is tried the moment the game is empty.
#
# [deploy with players] in any commit waiting to ship lifts the hold
# (owner, 2026-10-24: "ship now, just send the announcement before
# reboot"). It is the cloud session's version of running toc-deploy by
# hand: a cloud session can only push. It never skips CI -- that is
# [deploy now]'s, and only for its own commit -- so it may sit anywhere
# in the range: a commit pushed only to carry it works. Players get a
# minute's warning here, then toc-deploy's own announce, save and
# announce before the stop.
players=$(players_online)
case "$players" in
    0) ;;
    down)
        # Nothing is listening, so nobody is connected: the new code is
        # as good a thing to start as the old.
        why="$why; the game was not running" ;;
    *)
        if [ "$players" = unknown ]; then
            who="the game did not say who is online"
        else
            who="$players player(s) online"
        fi
        if ! git -C "$BUILD" log --format=%B "$live..$target" |
                has_marker '[deploy with players]'; then
            status "holding $short ($why): $who; deploying when the game is empty"
            exit 0
        fi
        why="$why; [deploy with players], $who"
        queue="$CURRENT/area/webadmin.queue"
        if [ -f "$queue" ]; then
            python3 -c 'import fcntl, sys
with open(sys.argv[1], "a", encoding="ascii") as f:
    fcntl.lockf(f.fileno(), fcntl.LOCK_EX)
    f.write(sys.argv[2] + "\n")' "$queue" \
                "announce|The game restarts for an update in one minute. Finish your fight; everyone is saved first." \
                2>/dev/null || true
        fi
        status "warning players ($who): deploying $short in ${TOC_PLAYERS_WARN_SECONDS:-60}s ($why)"
        sleep "${TOC_PLAYERS_WARN_SECONDS:-60}" ;;
esac

echo "$effective" > "$STATE_DIR/attempted"
status "deploying $short ($why)"
logger -t toc-auto-deploy "deploying $short ($why)" 2>/dev/null || true
rc=0
TOC_DEPLOY_LOCKED=1 TOC_DEPLOY_REF="$target" TOC_DEPLOY_ROLLBACK=1 \
    "$DEPLOY_BIN" > "$STATE_DIR/last.log" 2>&1 || rc=$?
if [ "$rc" = 0 ]; then
    status "deployed $short ($why)"
    logger -t toc-auto-deploy "deployed $short" 2>/dev/null || true
else
    # toc-deploy's exit status says how far it got; it used to be read as
    # "rolled back" whatever happened, including a build that failed
    # before the game was touched.
    case "$rc" in
        10) how="FAILED and was rolled back" ;;
        11) how="FAILED; rolled back but the game is NOT healthy" ;;
        12) how="FAILED; the new code is not healthy and was not rolled back" ;;
        13) how="FAILED to install; the game was restarted on its old code and is healthy" ;;
        14) how="FAILED to install; the game was restarted on its old code and is NOT healthy" ;;
        *)  how="FAILED before the game was touched (status $rc)" ;;
    esac
    status "deploy of $short $how; not retrying this commit -- see $STATE_DIR/last.log"
    logger -p daemon.err -t toc-auto-deploy "deploy of $short failed" 2>/dev/null || true
    tail -25 "$STATE_DIR/last.log"
    exit 1
fi
