#!/usr/bin/env python3
"""The host's backups and self-healing in one redacted verdict, every five
minutes (toc-heartbeat.timer; review, 2026-11-23).

Everything that can fail quietly is judged here from what it recorded, never
from systemd's word that a unit ran:

  game            toc-game-probe answers a count (the loop runs)
  web             the dashboard answers /api/health
  public_sync     toc-state-sync's last-success under 20 minutes old, and
                  what its last attempt said
  private_backup  toc-player-backup's last-success under 7 hours old -- and
                  "not-configured" when it has nothing to push to, which is a
                  problem, never healthy
  game_archives   the newest of the game's own archives (backups/) under
                  5 hours old
  disk            free space and inodes where the game writes
  recovery        how the last toc-game-recovery run ended, and the count of
                  failed restarts it holds
  units           every support unit loaded from the file the repository
                  ships, its timer running, nothing waiting on daemon-reload

It writes the verdict as JSON to /var/lib/toc/ops-summary.json (served at
/api/ops-summary) and to log/ops-summary.json in the live tree, which the
state sync carries to GitHub -- the first thing a review reads. Nothing in it
is private: no player, no message, no secret, and every IPv4 address masked.

Off the host: /etc/toc/heartbeat.env (optional, root's, 0600) may name
HEARTBEAT_URL, fetched when everything but the private backup is healthy,
and BACKUP_HEARTBEAT_URL, fetched when the private backup's verified copy is
fresh. A monitor (healthchecks.io, Better Stack, an OCI alarm on a custom
metric) alarms when a ping stops coming. When a check fails the URL is
fetched with HEARTBEAT_FAIL_SUFFIX ("/fail" by default; empty to send
nothing), so the alarm is at once rather than at the grace period. Missing,
each is reported "not-configured".

Staff hear of a failing or stale private backup on WIZINFO (never ANNOUNCE),
at most once an hour; the state sync's own check speaks for the public one.

Exit status: 0 when the verdict is "ok", 1 otherwise.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

E = os.environ.get
LIVE = Path(E("TOC_LIVE_ROOT", "/srv/toc/current"))
OUT = Path(E("TOC_OPS_SUMMARY", "/var/lib/toc/ops-summary.json"))
COPY = Path(E("TOC_OPS_SUMMARY_COPY", str(LIVE / "log" / "ops-summary.json")))
SYNC_STATE = Path(E("TOC_SYNC_STATE_DIR", "/var/lib/toc-state-sync"))
BACKUP_STATE = Path(E("TOC_BACKUP_STATE_DIR", "/var/lib/toc-player-backup"))
BACKUP_ENV = Path(E("TOC_BACKUP_ENV", "/etc/toc/player-backup.env"))
RECOVERY_STATE = Path(E("TOC_STATE_DIR", "/var/lib/toc"))
HEARTBEAT_ENV = Path(E("TOC_HEARTBEAT_ENV", "/etc/toc/heartbeat.env"))
PROBE = E("TOC_GAME_PROBE", "/usr/local/sbin/toc-game-probe")
WEB_HEALTH = E("TOC_WEB_HEALTH_URL", "http://127.0.0.1:9001/api/health")
DISK_PATH = E("TOC_DISK_PATH", "/srv/toc")
QUEUE = Path(E("TOC_QUEUE", str(LIVE / "area" / "webadmin.queue")))
UNIT_DIR = Path(E("TOC_UNIT_DIR", "/etc/systemd/system"))

SYNC_MAX_AGE = int(E("TOC_SYNC_MAX_AGE_MIN", "20")) * 60
BACKUP_MAX_AGE = int(E("TOC_BACKUP_MAX_AGE_MIN", "420")) * 60
ARCHIVE_MAX_AGE = int(E("TOC_ARCHIVE_MAX_AGE_MIN", "300")) * 60
DISK_MIN_MB = int(E("TOC_DISK_MIN_FREE_MB", "4096"))
INODE_MIN_PCT = int(E("TOC_DISK_MIN_INODE_PCT", "10"))
STAFF_GAP = int(E("TOC_OPS_STAFF_GAP", "3600"))

# The timers and path units that must be running, and the services they
# start (which must at least be loaded from the shipped file).
TIMERS = ["toc-state-sync.timer", "toc-state-sync-check.timer", "toc-game-recovery.timer",
          "toc-auto-deploy.timer", "toc-heartbeat.timer", "toc-host-action.path"]
SERVICES = ["toc-game.service", "toc-web.service", "toc-state-sync.service",
            "toc-state-sync-check.service", "toc-game-recovery.service",
            "toc-auto-deploy.service", "toc-heartbeat.service", "toc-host-action.service",
            "toc-player-backup.service"]
IPV4 = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")

now = int(time.time())
problems: list[str] = []


def clean(text: str, limit: int = 200) -> str:
    return IPV4.sub("<address>", " ".join(str(text).split()))[:limit]


def receipt(path: Path) -> dict[str, str]:
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return {}
    return {k.strip(): v.strip().strip("\"'") for k, _, v in (line.partition("=") for line in lines)
            if k.strip() and not k.lstrip().startswith("#")}


def age_of(stamp: str | None) -> int | None:
    try:
        return now - int(stamp or "")
    except ValueError:
        return None


def minutes(seconds: int | None) -> int | None:
    return None if seconds is None else seconds // 60


def check_game() -> dict:
    try:
        said = subprocess.run([PROBE], capture_output=True, text=True, timeout=20).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        said = "unknown"
    ok = said.isdigit()
    if not ok:
        problems.append(f"game: {said or 'no answer'}")
    return {"ok": ok, "state": "answering" if ok else (said or "unknown"),
            "players": int(said) if ok else None}


def check_web() -> dict:
    try:
        with urllib.request.urlopen(WEB_HEALTH, timeout=5) as reply:
            ok = reply.status == 200
    except Exception:        # noqa: BLE001 -- any failure is "not answering"
        ok = False
    if not ok:
        problems.append("web: the dashboard does not answer")
    return {"ok": ok}


def check_public_sync() -> dict:
    success, attempt = receipt(SYNC_STATE / "last-success"), receipt(SYNC_STATE / "last-attempt")
    age = age_of(success.get("time"))
    ok = age is not None and -300 <= age <= SYNC_MAX_AGE
    out = {"ok": ok, "last_success_min": minutes(age), "kind": success.get("kind"),
           "remote_commit": (success.get("remote_commit") or "")[:12] or None,
           "last_attempt": attempt.get("result"),
           "last_attempt_min": minutes(age_of(attempt.get("time"))),
           "reason": clean(attempt.get("reason", "")) or None}
    if not ok:
        problems.append("public_sync: " + ("no verified sync on record" if age is None
                                           else f"last verified sync {age // 60} min ago")
                        + (f" ({out['reason']})" if out["reason"] else ""))
    elif (attempt.get("reason") or "").startswith("refused"):
        out["ok"] = False
        problems.append(f"public_sync: {out['reason']}")
    return out


def check_private_backup() -> dict:
    status = (BACKUP_STATE / "status")
    word = status.read_text().strip() if status.exists() else ""
    success, attempt = receipt(BACKUP_STATE / "last-success"), receipt(BACKUP_STATE / "last-attempt")
    configured = BACKUP_ENV.exists() and word != "not-configured"
    age = age_of(success.get("time"))
    out = {"configured": configured, "status": word or "never-run",
           "last_success_min": minutes(age),
           "generations": success.get("generations"),
           "archive_bytes": success.get("archive_bytes"),
           "remote_commit": (success.get("remote_commit") or "")[:12] or None,
           "last_attempt": attempt.get("result"),
           "reason": clean(attempt.get("reason", "")) or None}
    if not configured:
        out["ok"] = False
        out["status"] = "not-configured"
        problems.append("private_backup: not configured (no encrypted off-host copy)")
    else:
        out["ok"] = age is not None and -300 <= age <= BACKUP_MAX_AGE and word == "ok"
        if not out["ok"]:
            problems.append("private_backup: " + ("never verified" if age is None
                                                  else f"last verified copy {age // 3600} h ago")
                            + (f" ({out['reason']})" if out["reason"] else ""))
    return out


def check_game_archives() -> dict:
    archives = sorted((LIVE / "backups").glob("*.tar.gz"), key=lambda p: p.stat().st_mtime)
    if not archives:
        problems.append("game_archives: none")
        return {"ok": False, "count": 0}
    age = now - int(archives[-1].stat().st_mtime)
    total = sum(p.stat().st_size for p in archives)
    ok = age <= ARCHIVE_MAX_AGE
    if not ok:
        problems.append(f"game_archives: newest is {age // 3600} h old")
    return {"ok": ok, "count": len(archives), "newest_min": age // 60,
            "total_mb": total // 1048576}


def check_disk() -> dict:
    try:
        usage = shutil.disk_usage(DISK_PATH)
        st = os.statvfs(DISK_PATH)
    except OSError:
        problems.append("disk: cannot be read")
        return {"ok": False}
    free_mb = usage.free // 1048576
    inode_pct = (100 * st.f_favail // st.f_files) if st.f_files else 100
    ok = free_mb >= DISK_MIN_MB and inode_pct >= INODE_MIN_PCT
    if not ok:
        problems.append(f"disk: {free_mb} MB and {inode_pct}% of inodes free")
    return {"ok": ok, "free_mb": free_mb, "inodes_free_pct": inode_pct}


def check_recovery() -> dict:
    last = receipt(RECOVERY_STATE / "recovery-last")
    try:
        failures = int((RECOVERY_STATE / "recovery-failures").read_text().strip() or 0)
    except (OSError, ValueError):
        failures = 0
    age = age_of(last.get("time"))
    ok = failures == 0 and last.get("exit", "0") == "0" and age is not None and age <= 900
    out = {"ok": ok, "last_run_min": minutes(age), "exit": last.get("exit"),
           "said": clean(last.get("said", "")) or None, "failed_restarts": failures}
    if not ok:
        problems.append("recovery: " + ("has not run in 15 minutes" if age is None or age > 900
                                        else f"last run exited {last.get('exit')}"
                                        f" ({out['said']}), {failures} failed restarts"))
    return out


def systemctl_show(unit: str) -> dict[str, str]:
    try:
        said = subprocess.run(["systemctl", "show", unit, "-p", "LoadState", "-p", "ActiveState",
                               "-p", "UnitFileState", "-p", "NeedDaemonReload",
                               "-p", "FragmentPath"],
                              capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return {k: v for k, _, v in (line.partition("=") for line in said.splitlines()) if k}


def check_units() -> dict:
    out: dict[str, dict] = {}
    bad = []
    backup_configured = BACKUP_ENV.exists()
    timers = TIMERS + (["toc-player-backup.timer"] if backup_configured else [])
    for unit in timers + SERVICES:
        shown = systemctl_show(unit)
        state = {"load": shown.get("LoadState", "unknown"),
                 "active": shown.get("ActiveState", "unknown"),
                 "enabled": shown.get("UnitFileState", "unknown"),
                 "from_shipped_file": shown.get("FragmentPath") == str(UNIT_DIR / unit),
                 "needs_daemon_reload": shown.get("NeedDaemonReload") == "yes"}
        out[unit] = state
        if state["load"] != "loaded" or not state["from_shipped_file"]:
            bad.append(f"{unit} not installed")
        elif state["needs_daemon_reload"]:
            bad.append(f"{unit} changed on disk, not reloaded")
        elif unit in timers and state["active"] != "active":
            bad.append(f"{unit} {state['active']}")
    if bad:
        problems.append("units: " + "; ".join(bad))
    return {"ok": not bad, "units": out}


def heartbeat(verdicts: dict) -> dict:
    conf = receipt(HEARTBEAT_ENV)
    suffix = conf.get("HEARTBEAT_FAIL_SUFFIX", "/fail")
    host_ok = all(verdicts[k]["ok"] for k in verdicts if k != "private_backup")
    out = {}
    for key, ok in (("HEARTBEAT_URL", host_ok),
                    ("BACKUP_HEARTBEAT_URL", verdicts["private_backup"]["ok"])):
        url = conf.get(key, "").strip()
        name = key.lower().replace("_url", "")
        if not url:
            out[name] = "not-configured"
            continue
        target = url if ok else (url.rstrip("/") + suffix if suffix else "")
        if not target:
            out[name] = "withheld"
            continue
        try:
            with urllib.request.urlopen(target, timeout=10) as reply:
                out[name] = ("sent ok" if ok else "sent fail") if reply.status < 400 else f"http {reply.status}"
        except Exception:    # noqa: BLE001
            out[name] = "unreachable"
            problems.append(f"heartbeat: {name} could not be sent")
    return out


def tell_staff(message: str) -> None:
    mark = RECOVERY_STATE / "ops-staff-last"
    try:
        if now - int(mark.read_text().strip() or 0) < STAFF_GAP:
            return
    except (OSError, ValueError):
        pass
    if not QUEUE.exists():
        return
    try:
        with open(QUEUE, "a", encoding="ascii", errors="replace") as queue:
            fcntl.lockf(queue.fileno(), fcntl.LOCK_EX)
            queue.write(f"wizinfo|60|{message}\n")
        mark.write_text(f"{now}\n")
    except OSError:
        pass


def write_atomic(path: Path, text: str) -> bool:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(f".{path.name}.{os.getpid()}")
        tmp.write_text(text, encoding="utf-8")
        tmp.chmod(0o644)
        os.replace(tmp, path)
        return True
    except OSError:
        return False


def main() -> int:
    verdicts = {"game": check_game(), "web": check_web(), "public_sync": check_public_sync(),
                "private_backup": check_private_backup(), "game_archives": check_game_archives(),
                "disk": check_disk(), "recovery": check_recovery(), "units": check_units()}
    beats = heartbeat(verdicts)
    backup = verdicts["private_backup"]
    if backup["configured"] and not backup["ok"]:
        tell_staff("The encrypted off-host player backup is not working: "
                   + next(p for p in problems if p.startswith("private_backup")).split(": ", 1)[1]
                   + ". Saves are still on disk and in the public sync.")
    summary = {"schema": 1, "generated": now,
               "generated_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
               "overall": "ok" if not problems else "degraded",
               "problems": [clean(p, 300) for p in problems],
               "checks": verdicts, "heartbeat": beats}
    text = json.dumps(summary, indent=1, sort_keys=True) + "\n"
    text = IPV4.sub("<address>", text)
    if not write_atomic(OUT, text):
        print(f"could not write {OUT}", file=sys.stderr)
        return 1
    if COPY.parent.is_dir():
        write_atomic(COPY, text)
    print(f"{summary['overall']}: " + ("; ".join(summary["problems"]) or "all checks pass"))
    return 0 if not problems else 1


if __name__ == "__main__":
    sys.exit(main())
