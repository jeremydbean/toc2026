[Unit]
Description=Push live player state to GitHub every few minutes
Documentation=https://github.com/jeremydbean/toc2026/blob/main/wiki/windows-production-hosting.md

[Timer]
# Fifteen minutes is the most a crash can cost. It was five, which
# was a commit every five minutes forever -- too much noise in the
# history for what it buys. Persistent so a sync missed while the
# host was off runs once it is back.
OnBootSec=3min
OnUnitActiveSec=15min
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
