[Unit]
Description=Push live player state to GitHub
Documentation=https://github.com/jeremydbean/toc2026/blob/main/wiki/disaster-recovery.md

[Timer]
# Every five minutes, so a character who signs out is off the machine
# within five minutes of doing it.
#
# This was briefly widened to fifteen minutes and then to daily, both
# times trying to quiet CI. That was the wrong lever: a validate per
# sync is stopped by paths-ignore in the workflow and [skip ci] in the
# commit, and with those in place the interval costs nothing but
# history. Frequent is what protects the characters, so frequent it is.
OnBootSec=3min
OnUnitActiveSec=5min
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
