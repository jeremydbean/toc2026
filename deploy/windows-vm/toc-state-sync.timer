[Unit]
Description=Push live player state to GitHub
Documentation=https://github.com/jeremydbean/toc2026/blob/main/wiki/disaster-recovery.md

[Timer]
# Every minute: the backstop. A save reaches GitHub within seconds on its
# own (toc-state-sync.path, owner 2026-11-23); this catches what that does
# not see -- saves that went on through three rounds of a run, a snapshot in
# player/versions/, a board or report file -- within a minute.
#
# It was every five minutes until 2026-11-23, so a character who signed
# out was off the machine within five minutes.
#
# This was briefly widened to fifteen minutes and then to daily, both
# times trying to quiet CI. That was the wrong lever: a validate per
# sync is stopped by paths-ignore in the workflow and [skip ci] in the
# commit, and with those in place the interval costs nothing but
# history. Frequent is what protects the characters, so frequent it is.
#
# On the wall clock (review, 2026-11-23): OnUnitActiveSec counts from the
# service's last activation, so the retry after a failed run leaned on how
# systemd treats a failed oneshot, and Persistent= does nothing at all for a
# monotonic timer -- it applies only to OnCalendar=. A calendar timer fires
# every minute whatever the last run did, and Persistent=true then
# really runs one missed while the machine was down, at boot.
#
# Measured, 2026-11-24 (systemd 255): a save made while a run is going is
# NOT picked up by the path unit -- the change is dropped -- so before the
# sync went round again itself (toc-state-sync, COPY_MARK) such a save
# waited for this tick. AccuracySec=30s let systemd fire it anywhere in
# the first half-minute; 1s keeps the backstop at the minute.
OnCalendar=*-*-* *:*:00
OnBootSec=3min
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
