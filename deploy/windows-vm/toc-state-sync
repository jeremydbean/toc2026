#!/bin/sh
# Push live game state to GitHub so an outage can never cost more than
# the last few minutes of play.
#
# The Pi died at 07:57 on 2026-09-29 with no warning and no clean
# shutdown. Its saves survived only because the card was readable; the
# next failure might not be so kind. This runs every few minutes and
# commits the state as it stands, in plaintext, to the main repository
# -- which is also where anyone cloning the game to run it themselves
# will find it.
#
# That plaintext is a deliberate choice by the owner, taken with the
# consequences understood: these files carry DES password hashes and
# player addresses, the repository is public, and the transport was
# never private. This is a test environment and the owner would rather
# lose the secrecy than the characters. Do not quietly re-encrypt this
# or move it to a private mirror.
#
# The work happens in a clone of its own. The deployed tree is not a
# git repository and must not become one: the installer rsyncs over it.
set -eu

TOC_ROOT="${TOC_ROOT:-/srv/toc/current}"
STATE_REPO="${STATE_REPO:-/srv/toc/state-repo}"
REMOTE="${REMOTE:-git@github.com:jeremydbean/toc2026.git}"
BRANCH="${BRANCH:-main}"
GIT_SSH_KEY="${GIT_SSH_KEY:-/srv/toc/.ssh/id_ed25519_state_sync}"
# systemd makes this directory for us and gives it to the service user;
# /run itself is root-owned and the service runs as toc.
LOCK_FILE="${LOCK_FILE:-/run/toc-state-sync/lock}"
# What the last run did, and the last run that really finished (review,
# 2026-11-23: the unit counted exit 1 as success, and the check judged
# systemd's "success" and a recent exit -- so a sync failing every run
# looked healthy). Two small files, each written aside and renamed over:
#
#   last-attempt  every run: when, ok / nochange / skipped / failed, why
#   last-success  only a run whose result is on GitHub -- a push GitHub
#                 then shows, or a no-change run whose tree GitHub holds
#
# toc-state-sync-check and toc-ops-summary judge these, never the exit.
# systemd makes the directory for the service user (StateDirectory=).
SYNC_STATE_DIR="${TOC_SYNC_STATE_DIR:-/var/lib/toc-state-sync}"
# Fail closed on a tree that shrank past belief (review, 2026-11-23: an
# empty or half-mounted player/ would have been mirrored with --delete and
# pushed over the last good state). player/, gods/ and heroes/ may lose at
# most MAX_DROP_PCT of their files in one run once they hold GUARD_MIN, and
# may never go from some to none; corpse/live, whose corpses rot away on
# their own, only past CORPSE_MAX_DROP_PCT of CORPSE_GUARD_MIN. A drop that
# is meant (a purge of old characters) is let through once by a reason
# written to $SYNC_STATE_DIR/allow-drop, under a day old, which the run
# records in its commit and the journal and then sets aside as used.
MAX_DROP_PCT="${TOC_SYNC_MAX_DROP_PCT:-20}"
GUARD_MIN="${TOC_SYNC_GUARD_MIN:-10}"
CORPSE_MAX_DROP_PCT="${TOC_SYNC_CORPSE_MAX_DROP_PCT:-90}"
CORPSE_GUARD_MIN="${TOC_SYNC_CORPSE_GUARD_MIN:-50}"
ALLOW_DROP_MAX_AGE="${TOC_SYNC_ALLOW_DROP_MAX_AGE:-86400}"

# A network that drops packets left ssh waiting out the kernel's SYN
# retries -- about two minutes per git command -- with the unit held and
# the timer's ticks merged into it (review, 2026-11-24).
export GIT_SSH_COMMAND="ssh -i $GIT_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

# What counts as state. Everything here is in .gitignore, so every add
# needs -f; that is the point, not an accident.
#
# These must be the names the game actually writes. Until 2026-10-01
# seven of them were listed without their .txt -- area/pkilldata for
# area/pkilldata.txt -- and the loop below skips a path that does not
# exist without a word, so PK standings, the wizlist, max-load state
# and the ban list had not reached GitHub since the initial commit.
# tests/test_training_dummy.py checks every name here against a file
# the game writes.
# heroes/ is here because the Hall of Heroes plaque is drawn from it
# (show_hero_plaque reads HERO_DIR), and 83 of those 212 records
# belong to heroes with no character file left -- this is the only
# copy of their names. A restore without it brings the game back
# with a blank plaque.
STATE_DIRS="player gods heroes log"
STATE_FILES="area/notes.txt area/bugs.txt area/ideas.txt area/typos.txt
             area/pkilldata.txt area/wizlist.txt
             area/offense.txt area/relics.txt area/not.txt area/ban.txt
             area/dpsboard.txt area/custom.are"
# The player report files. REPORTS CLEAR renames one aside as
# <file>.<stamp> rather than deleting it, and those archives are the only
# record of what players reported -- so they are saved too, and a report
# file the game no longer has is taken out of the repository. Until
# 2026-10-03 neither happened: the archives lived on the host alone, and
# a cleared file sat in git for ever, where toc-restore would have laid
# the cleared reports back down.
REPORT_FILES="area/bugs.txt area/ideas.txt area/typos.txt"
BUILT_DIR="area/built"

# --- the receipts ---------------------------------------------------------
RESULT=failed
REASON="stopped before it finished"
STEP=start
REMOTE_COMMIT=""
# A success that left something behind says so (review, 2026-11-23: an
# hourly copy that failed was a plain "ok", so monitoring read a partial
# backup as a whole one). "; "-separated, empty for a whole run.
PARTIAL=""
CARRIED=0
PRESERVE_KEEP="${TOC_SYNC_PRESERVE_KEEP:-20}"
mkdir -p "$SYNC_STATE_DIR" 2>/dev/null || true

# KEY=VALUE lines from stdin into $SYNC_STATE_DIR/$1, whole or not at all.
receipt_write() {
    tmp="$SYNC_STATE_DIR/.$1.tmp.$$"
    if cat >"$tmp" 2>/dev/null && sync "$tmp" 2>/dev/null && mv -f "$tmp" "$SYNC_STATE_DIR/$1"; then
        return 0
    fi
    rm -f "$tmp" 2>/dev/null
    echo "could not write $SYNC_STATE_DIR/$1" >&2
    return 1
}

# Every way out of this script records the attempt -- a set -e failure
# too, by the step it was on. A value never holds a newline or a tab.
on_exit() {
    code=$?
    # Another run holds the lock and will record its own attempt.
    [ "$RESULT" = busy ] && return 0
    [ "$code" -ne 0 ] && [ "$RESULT" != failed ] && RESULT=failed
    [ "$RESULT" = failed ] && [ "$REASON" = "stopped before it finished" ] &&
        REASON="failed during $STEP (exit $code)"
    printf 'time=%s\ntime_utc=%s\nresult=%s\nreason=%s\nexit=%s\nremote_commit=%s\npartial=%s\n' \
        "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$RESULT" \
        "$(printf '%s' "$REASON" | tr '\t\n' '  ')" "$code" "$REMOTE_COMMIT" \
        "$(printf '%s' "${PARTIAL%; }" | tr '\t\n' '  ')" |
        receipt_write last-attempt || true
    if [ "$RESULT" = failed ]; then
        logger -t toc-state-sync -p daemon.err "state sync failed: $REASON" 2>/dev/null || true
    fi
    # A save that landed after this run's copy (review, 2026-11-24). The
    # path unit does not start a sync for a change made while one is
    # running (measured on systemd 255: the change is dropped), so a save
    # in the seconds after the copy waited for the next timer tick -- a
    # minute and more -- however quiet the game was after it. Anything in
    # the watched directories newer than the copy goes round again here,
    # after the same debounce, at most TOC_SYNC_MAX_ROUNDS runs in all; a
    # game saving without pause is left to the timer.
    again=""
    if { [ "$RESULT" = ok ] || [ "$RESULT" = nochange ]; } &&
       [ -n "${COPY_MARK:-}" ] && [ -n "${WATCHED:-}" ] &&
       [ "${SYNC_ROUND:-1}" -lt "${SYNC_MAX_ROUNDS:-3}" ]; then
        again=$(find $WATCHED -maxdepth 1 -newer "$COPY_MARK" -print 2>/dev/null | head -1)
    fi
    [ -n "${COPY_MARK:-}" ] && rm -f "$COPY_MARK"
    if [ -n "$again" ]; then
        echo "saved again since the copy; going round again"
        TOC_SYNC_ROUND=$((${SYNC_ROUND:-1} + 1))
        export TOC_SYNC_ROUND
        sleep "${SYNC_DEBOUNCE:-3}"
        exec sh "$0"
    fi
}
trap on_exit EXIT
SYNC_ROUND=${TOC_SYNC_ROUND:-1}
SYNC_MAX_ROUNDS=${TOC_SYNC_MAX_ROUNDS:-3}
SYNC_DEBOUNCE=${TOC_SYNC_DEBOUNCE:-3}
COPY_MARK=""
# What toc-state-sync.path watches: the top of each, not below.
WATCHED=""
for w in player gods heroes corpse/live; do
    [ -d "$TOC_ROOT/$w" ] && WATCHED="$WATCHED $TOC_ROOT/$w"
done

fail() { RESULT=failed; REASON="$1"; echo "$1" >&2; exit 1; }
skip() { RESULT=skipped; REASON="$1"; echo "$1"; exit 0; }

# The remote shows this commit, or one built on it: then what this run
# holds is on GitHub. Asked of GitHub itself, never of the clone's idea of
# the remote.
remote_holds() {
    want=$1
    seen=$(git ls-remote origin "refs/heads/$BRANCH" 2>/dev/null | cut -f1)
    [ -n "$seen" ] || return 1
    REMOTE_COMMIT=$seen
    [ "$seen" = "$want" ] && return 0
    git fetch --quiet origin "$BRANCH" 2>/dev/null || return 1
    git merge-base --is-ancestor "$want" "origin/$BRANCH" 2>/dev/null
}

record_success() {
    printf 'time=%s\ntime_utc=%s\nkind=%s\nremote_commit=%s\nlocal_commit=%s\nfiles_changed=%s\ncharacters=%s\npartial=%s\n' \
        "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$REMOTE_COMMIT" \
        "$(git rev-parse HEAD)" "$2" "$3" \
        "$(printf '%s' "${PARTIAL%; }" | tr '\t\n' '  ')" | receipt_write last-success ||
        fail "the sync finished but its receipt could not be written"
}

# A second, private copy (owner, 2026-11-23): the commit GitHub has just
# been shown to hold, pushed in plaintext to a private repository. Never
# forced, so the mirror can only ever be behind the public copy, never
# different from it. Best effort: a mirror that fails costs this run
# nothing -- the public push is the backup -- but its receipt says so,
# the journal says so, and the operations summary reports it. Off unless
# MIRROR_REMOTE is set (toc-state-sync.service sets it on the live host).
MIRROR_REMOTE="${MIRROR_REMOTE:-}"
MIRROR_SSH_KEY="${MIRROR_SSH_KEY:-/srv/toc/.ssh/id_ed25519_github_mirror}"
mirror_push() {
    [ -n "$MIRROR_REMOTE" ] || return 0
    STEP=mirror
    m_commit=$(git rev-parse HEAD)
    if [ ! -r "$MIRROR_SSH_KEY" ]; then
        m_result=failed
        m_reason="mirror key not readable: $MIRROR_SSH_KEY"
    elif m_out=$(GIT_SSH_COMMAND="ssh -i $MIRROR_SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4" \
                 git push --quiet "$MIRROR_REMOTE" "$m_commit:refs/heads/$BRANCH" 2>&1); then
        m_result=ok
        m_reason="mirror holds $(printf '%.12s' "$m_commit")"
    else
        m_result=failed
        m_reason=$(printf '%s' "$m_out" | tr '\t\n' '  ' | cut -c1-200)
        [ -n "$m_reason" ] || m_reason="git push to the mirror failed"
    fi
    printf 'time=%s\ntime_utc=%s\nresult=%s\nreason=%s\ncommit=%s\n' \
        "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$m_result" "$m_reason" "$m_commit" |
        receipt_write mirror || true
    if [ "$m_result" = failed ]; then
        logger -t toc-state-sync -p daemon.warning "private mirror not updated: $m_reason" 2>/dev/null || true
    fi
    return 0
}

[ -d "$TOC_ROOT/player" ] || fail "no player dir at $TOC_ROOT"
[ -r "$GIT_SSH_KEY" ] || fail "no deploy key at $GIT_SSH_KEY"

# One at a time. A sync that overlaps itself fights over the index.
exec 9>"$LOCK_FILE"
flock -n 9 || { RESULT=busy; echo "another sync is running"; exit 0; }

if [ ! -d "$STATE_REPO/.git" ]; then
    echo "cloning $REMOTE into $STATE_REPO"
    # Shallow: the sync only ever adds a commit on top of main, and the
    # history is GitHub's to keep. A full clone took ten minutes of CPU
    # and its object store grew to 24 GB (2026-11-22).
    git clone --depth 1 --branch "$BRANCH" "$REMOTE" "$STATE_REPO"
    git -C "$STATE_REPO" config user.name "toc state sync"
    git -C "$STATE_REPO" config user.email "toc@localhost"
fi

cd "$STATE_REPO"

# Self-repair (owner, 2026-11-22: the sync failed for a day and nothing
# fixed it). This run holds the sync's own lock, so no other git here is
# running: a lock file or a rebase left behind is from a run that was
# killed (a timeout, the OOM killer, a reboot), and would fail every run
# after it.
for stale in .git/index.lock .git/HEAD.lock .git/shallow.lock \
             ".git/refs/heads/$BRANCH.lock" ".git/refs/remotes/origin/$BRANCH.lock"; do
    [ -e "$stale" ] && rm -f -- "$stale" && echo "removed $stale, left by a run that was killed" >&2
done
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
    git rebase --abort 2>/dev/null || rm -rf .git/rebase-merge .git/rebase-apply
    echo "abandoned a rebase left by a run that was killed" >&2
fi

# A clone git itself calls broken -- "object file ... is empty" after a
# crash mid-write, as on 2026-10-01, or a missing object -- is moved aside
# and made again from GitHub, which holds everything it did but the commit
# this run is about to make anyway. A fetch that fails for any other reason
# (the network, GitHub, the key) is only reported: cloning again would not
# help it. At most once in RECLONE_GAP, so a clone that breaks again at
# once is left for a person (the website's "Repair the state sync" still
# works), and only the newest RECLONE_KEEP copies set aside this way are
# kept; one moved aside by a person is never removed here.
RECLONE_GAP="${TOC_STATE_RECLONE_GAP:-3600}"
RECLONE_KEEP=2
RECLONE_MIN_FREE_MB="${TOC_STATE_RECLONE_MIN_FREE_MB:-2048}"
clone_broken() {
    # A full disk fails every write the same way, and is no broken clone.
    grep -qi 'no space left' "$1" && return 1
    git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || return 0
    grep -qiE 'corrupt|is empty|bad object|loose object|index file|not a git repository|unable to read|broken link|missing (blob|tree|commit)|invalid (sha1|object)' "$1" && return 0
    git fsck --connectivity-only --no-progress >/dev/null 2>&1 || return 0
    return 1
}
reclone() {
    made=$(cat "$STATE_REPO/.git/toc-recloned" 2>/dev/null || echo 0)
    case "$made" in ''|*[!0-9]*) made=0 ;; esac
    age=$(( $(date +%s) - made ))
    if [ "$age" -lt "$RECLONE_GAP" ]; then
        echo "the clone is broken again ${age}s after it was made afresh; leaving it for a person" >&2
        return 1
    fi
    # Never set a clone aside with no room to make another.
    free_mb=$(df -Pm "$(dirname "$STATE_REPO")" 2>/dev/null | awk 'NR==2 {print $4}')
    case "$free_mb" in ''|*[!0-9]*) free_mb=0 ;; esac
    if [ "$free_mb" -lt "$RECLONE_MIN_FREE_MB" ]; then
        echo "the clone is broken, but only ${free_mb} MB is free; not cloning afresh" >&2
        return 1
    fi
    cd /
    aside="$STATE_REPO.broken-auto-$(date -u +%Y%m%d-%H%M%S)"
    mv "$STATE_REPO" "$aside" || { echo "cannot move the broken clone aside" >&2; return 1; }
    echo "the clone was broken; moved it to $aside and cloning afresh" >&2
    git clone --quiet --depth 1 --branch "$BRANCH" "$REMOTE" "$STATE_REPO" || return 1
    git -C "$STATE_REPO" config user.name "toc state sync"
    git -C "$STATE_REPO" config user.email "toc@localhost"
    date +%s > "$STATE_REPO/.git/toc-recloned"
    ls -1d "$STATE_REPO".broken-auto-* 2>/dev/null | sort -r | tail -n +$((RECLONE_KEEP + 1)) |
        while read -r old; do rm -rf -- "$old"; done
    cd "$STATE_REPO"
}

# Commits an earlier run made and could not push are the only copy, off
# the live tree, of the state they hold (review, 2026-11-23: the reset
# below threw them away, so a player file then lost or damaged on the host
# could not be had back from them). Never reset over them: each is kept as
# a ref in the clone and a bundle beside the receipts, then carried onto
# GitHub's branch to go with this run's push; only if it cannot be carried
# cleanly is the clone reset, with the copies kept and the run incomplete.
# Inside an `if`, so set -e is off here: every failure returns.
prune_preserved() {
    git for-each-ref --sort=-refname --format='%(refname)' refs/toc/unpushed/ 2>/dev/null |
        tail -n +$((PRESERVE_KEEP + 1)) | while read -r ref; do git update-ref -d "$ref"; done
    ls -1 "$SYNC_STATE_DIR"/unpushed-*.bundle 2>/dev/null | sort -r |
        tail -n +$((PRESERVE_KEEP + 1)) | while read -r old; do rm -f -- "$old"; done
}
bring_up_to_date() {
    ahead=$(git rev-list --count "origin/$BRANCH..HEAD") || return 1
    if [ "$ahead" -eq 0 ]; then
        git reset --quiet --hard "origin/$BRANCH"
        return
    fi
    stamp=$(date -u +%Y%m%d-%H%M%S)
    kept="refs/toc/unpushed/$stamp"
    git update-ref "$kept" HEAD || return 1
    git bundle create "$SYNC_STATE_DIR/unpushed-$stamp.bundle" "origin/$BRANCH..HEAD" >/dev/null 2>&1 ||
        NOTE="${NOTE}no bundle written for $kept; "
    # Leftovers of an interrupted copy are made again from the live tree.
    git reset --quiet --hard HEAD || return 1
    if git rebase --quiet "origin/$BRANCH" >/dev/null 2>&1; then
        CARRIED=$ahead
        NOTE="${NOTE}carrying $ahead unpushed commit(s), kept at $kept; "
    else
        git rebase --abort >/dev/null 2>&1 || true
        git reset --quiet --hard "origin/$BRANCH" || return 1
        PARTIAL="${PARTIAL}$ahead unpushed commit(s) not carried, kept at $kept; "
    fi
    prune_preserved
}

# Somebody else pushes to this branch too -- a developer, or me from
# the host. Take their work first and put ours on top, rather than
# forcing and losing theirs.
STEP=fetch
NOTE=""
git_err=$(mktemp)
if ! { git fetch --quiet origin "$BRANCH" && bring_up_to_date; } 2>"$git_err"; then
    cat "$git_err" >&2
    if clone_broken "$git_err"; then
        rm -f "$git_err"
        reclone || fail "the clone was broken and could not be made again"
    else
        rm -f "$git_err"
        fail "could not bring the clone up to date (not a broken clone; the network, GitHub or the key)"
    fi
fi
rm -f "$git_err"
if [ -n "$NOTE" ]; then
    echo "${NOTE%; }" >&2
    logger -t toc-state-sync -p daemon.warning "${NOTE%; }" 2>/dev/null || true
fi
[ -n "$PARTIAL" ] && logger -t toc-state-sync -p daemon.err "${PARTIAL%; }" 2>/dev/null || true

# Never copy while a deploy holds its lock: a rollback extracting over
# the live tree could hand us a half-written custom.are. A shared lock,
# held only for the copy (a second or two), so it never blocks a deploy
# for longer than that; a deploy holding it skips this run, and the next
# one, five minutes on, picks everything up. toc-deploy creates the lock
# file as root, so it is opened read-only here.
DEPLOY_LOCK="${TOC_DEPLOY_LOCK:-/run/toc-deploy.lock}"
if [ -r "$DEPLOY_LOCK" ]; then
    exec 8<"$DEPLOY_LOCK"
    # Waited for, briefly (review, 2026-11-24): toc-game-recovery holds it
    # for half a second every two minutes and auto-deploy's check for two or
    # three every ten, and a path-started sync that met either was skipped
    # outright -- its save left for the next timer tick. A deploy or a
    # restore holds it far longer than this, and is still skipped.
    flock -w "${TOC_SYNC_LOCK_WAIT:-15}" -s 8 || skip "a deploy is running; skipping this sync"
elif [ -e "$DEPLOY_LOCK" ]; then
    # A lock that exists but cannot be read cannot be asked: fail closed
    # rather than copy past a deploy that may hold it (review, 2026-10-22).
    RESULT=skipped; REASON="cannot read $DEPLOY_LOCK; skipping this sync"
    echo "$REASON" >&2
    exit 0
fi

# --- the drop guard (see MAX_DROP_PCT above), before anything is copied ---
STEP=guard
# Files under $1, versions/ left out as the copy leaves it out; nothing
# printed when the tree cannot be read all the way down.
count_files() {
    err=$(mktemp)
    n=$(find "$1" -path "$1/versions" -prune -o -type f -print 2>"$err" | wc -l)
    if [ -s "$err" ]; then rm -f "$err"; return 1; fi
    rm -f "$err"
    printf '%s\n' "$n"
}
OVERRIDE="$SYNC_STATE_DIR/allow-drop"
override_reason=""
if [ -f "$OVERRIDE" ]; then
    made=$(stat -c %Y "$OVERRIDE" 2>/dev/null || echo 0)
    if [ $(( $(date +%s) - made )) -le "$ALLOW_DROP_MAX_AGE" ]; then
        override_reason=$(head -c 200 "$OVERRIDE" | tr -d '\r' | tr '\t\n' '  ')
        [ -n "$override_reason" ] || override_reason="(no reason given)"
    else
        echo "ignoring $OVERRIDE: older than ${ALLOW_DROP_MAX_AGE}s" >&2
    fi
fi
dropped=""
guard() {   # DIR MAX_PCT MIN EMPTY_IS_A_DROP
    [ -d "$STATE_REPO/$1" ] || return 0
    have=$(count_files "$STATE_REPO/$1") || fail "cannot read the last good copy of $1"
    [ "$have" -gt 0 ] || return 0
    if [ ! -d "$TOC_ROOT/$1" ]; then
        now_n=0
    else
        now_n=$(count_files "$TOC_ROOT/$1") || fail "cannot read all of $TOC_ROOT/$1; nothing was copied"
    fi
    if [ "$now_n" -eq 0 ] && [ "$4" = yes ]; then
        dropped="$dropped $1:$have->0"
    elif [ "$have" -ge "$3" ] && [ $(( now_n * 100 )) -lt $(( have * (100 - $2) )) ]; then
        dropped="$dropped $1:$have->$now_n"
    fi
}
for d in player gods heroes; do
    guard "$d" "$MAX_DROP_PCT" "$GUARD_MIN" yes
done
guard corpse/live "$CORPSE_MAX_DROP_PCT" "$CORPSE_GUARD_MIN" no

# Each part on its own as well (review, 2026-11-23). player/ held 977
# files, 934 of them archive/: every active character, the recovery ledger
# and the diaries together were under the 20% line of the whole, so a
# missing or half-mounted subtree could leave GitHub's tree unremarked --
# and toc-restore lays down that tree, not its history. A part that had
# files and has none is a drop at any size; one of $GUARD_MIN files or more,
# a drop past $MAX_DROP_PCT.
judge() {   # LABEL HAVE NOW
    if [ "$2" -gt 0 ] && [ "$3" -eq 0 ]; then
        dropped="$dropped $1:$2->0"
    elif [ "$2" -ge "$GUARD_MIN" ] && [ $(( $3 * 100 )) -lt $(( $2 * (100 - MAX_DROP_PCT) )) ]; then
        dropped="$dropped $1:$2->$3"
    fi
}
# Characters by name: archiving (player_archive_dormant) moves one from
# player/ to player/archive/ and a login moves it back, so a name is gone
# only when it is in neither.
characters() {   # DIR -> the top-level file names, one a line
    err=$(mktemp)
    find "$1" -mindepth 1 -maxdepth 1 -type f -exec basename {} \; 2>"$err" | LC_ALL=C sort -u
    if [ -s "$err" ]; then rm -f "$err"; return 1; fi
    rm -f "$err"
}
if [ -d "$STATE_REPO/player" ]; then
    # Into a file, never through a pipe: `fail` in a pipeline runs in a
    # subshell and would end only that.
    live_all=$(mktemp)
    for part in player player/archive; do
        [ -d "$TOC_ROOT/$part" ] || continue
        characters "$TOC_ROOT/$part" >> "$live_all" ||
            fail "cannot read all of $TOC_ROOT/$part; nothing was copied"
    done
    LC_ALL=C sort -u -o "$live_all" "$live_all"
    for part in . archive; do
        [ -d "$STATE_REPO/player/$part" ] || continue
        names=$(characters "$STATE_REPO/player/$part") ||
            fail "cannot read the last good copy of player/$part"
        # comm, not grep -f: an empty pattern file -- every character gone,
        # the very case this is for -- gave grep no count at all.
        have=$(printf '%s\n' "$names" | grep -c . || true)
        kept=$(printf '%s\n' "$names" | LC_ALL=C comm -12 - "$live_all" | grep -c . || true)
        have=${have:-0}
        kept=${kept:-0}
        [ "$part" = . ] && label="player/*" || label="player/$part"
        judge "$label" "$have" "$kept"
    done
    rm -f "$live_all"
    for part in "$STATE_REPO"/player/*/; do
        [ -d "$part" ] || continue
        name=$(basename "$part")
        case "$name" in versions|archive) continue ;; esac
        have=$(count_files "$STATE_REPO/player/$name") ||
            fail "cannot read the last good copy of player/$name"
        now_n=0
        if [ -d "$TOC_ROOT/player/$name" ]; then
            now_n=$(count_files "$TOC_ROOT/player/$name") ||
                fail "cannot read all of $TOC_ROOT/player/$name; nothing was copied"
        fi
        judge "player/$name" "$have" "$now_n"
    done
    # The recovery records only grow -- ledger.tsv (every restore, milestone
    # and identity), renames.tsv (every retired name): one shorter than its
    # last good copy was cut, whatever the counts say.
    for f in "$STATE_REPO"/player/recovery/*.tsv; do
        [ -f "$f" ] || continue
        rel=${f#"$STATE_REPO/"}
        was=$(( $(wc -c < "$f") ))
        now_b=0
        [ -f "$TOC_ROOT/$rel" ] && now_b=$(( $(wc -c < "$TOC_ROOT/$rel") ))
        [ "$now_b" -lt "$was" ] && dropped="$dropped $rel:${was}B->${now_b}B"
    done
fi
if [ -n "$dropped" ]; then
    if [ -z "$override_reason" ]; then
        fail "refused: the live tree shrank past belief (${dropped# }); nothing was copied or pushed, and GitHub keeps the last good state. If it is meant, write a reason to $OVERRIDE"
    fi
    echo "drop allowed by $OVERRIDE (${dropped# }): $override_reason" >&2
    logger -t toc-state-sync -p daemon.warning "drop allowed by override (${dropped# }): $override_reason" 2>/dev/null || true
fi

STEP=copy
# Before the first file is read: a save after this is newer than it.
COPY_MARK="$SYNC_STATE_DIR/copy-mark"
touch "$COPY_MARK" 2>/dev/null || COPY_MARK=""
for d in $STATE_DIRS; do
    [ -d "$TOC_ROOT/$d" ] || continue
    mkdir -p "$STATE_REPO/$d"
    # versions/ is the game's own rolling backup of saves. One copy of
    # history is enough and git is already keeping it.
    rsync -a --delete --exclude 'versions/' "$TOC_ROOT/$d/" "$STATE_REPO/$d/"
done

# The results of the host's maintenance actions (toc-host-action), so a
# session that can only reach GitHub reads what the one it asked for did
# (ops/host-requests.txt). After log/'s mirror above, which removes them,
# so this keeps exactly the results the helper keeps. They name no player,
# and an IPv4 address in one is masked all the same.
HOST_ACTION_RESULTS="${TOC_HOST_ACTION_RESULTS:-/var/lib/toc-host-actions}"
if [ -d "$HOST_ACTION_RESULTS" ] && [ -r "$HOST_ACTION_RESULTS" ]; then
    mkdir -p "$STATE_REPO/log/host-actions"
    for f in "$HOST_ACTION_RESULTS"/*; do
        name=${f##*/}
        case "$name" in *[!0-9a-f]*) continue ;; esac
        [ "${#name}" -eq 32 ] && [ -f "$f" ] && [ -r "$f" ] || continue
        sed -E 's/(^|[^0-9.])([0-9]{1,3}\.){3}[0-9]{1,3}([^0-9.]|$)/\1<address>\3/g' \
            "$f" > "$STATE_REPO/log/host-actions/$name" || true
    done
fi

# Except the milestones (owner, 2026-10-23: nearly impossible to lose a
# player). A copy of a character taken just before a death, a remort, a
# deletion, a staff change or a restore is the exact state worth going
# back to, and the five-minute history above can miss it by up to five
# minutes: a death's own save, a moment later, already shows the gear
# gone. So every tagged copy -- "<Name>.<stamp>[_NN].<kind>", two dots --
# reaches git too, the restores' undo copies and the death penalty's
# included (handoff review, 2026-10-23: a restore needed to be undoable
# from git as well), and is never deleted from it here (no --delete),
# even after the host prunes its copy. Level and quest copies stay on the
# host; player/'s history here holds those moments well enough. An
# ordinary save ("<Name>.<stamp>", one dot) and a partial never match.
if [ -d "$TOC_ROOT/player/versions" ]; then
    mkdir -p "$STATE_REPO/player/versions"
    rsync -a --include='*/' --exclude='.*' \
          --exclude='*.level' --exclude='*.quest' \
          --include='*.*.*' --exclude='*' \
          "$TOC_ROOT/player/versions/" "$STATE_REPO/player/versions/"
fi

# And the hourly copies (owner, 2026-10-24: "make the hourly snapshots
# back up off the server too"). The game snapshots a character at every
# save, at most once a minute, and keeps every copy for a day, the newest
# of each hour for a week and of each day for a year (snapshot_prune in
# save.c). Git gets the newest ordinary copy of each finished hour --
# not every minute's, which would be noise -- and mirrors the host's
# keeping of them: a copy the host has pruned is removed here too (git's
# history still holds it), so a rebuilt host's PRESTORE lists the same
# hourly and daily copies the lost one did. The hour still running is
# left until it ends, so its copy is not replaced on every run.
# Tagged copies are the rsync's above and are never touched here.
if [ -d "$TOC_ROOT/player/versions" ] && ! command -v python3 >/dev/null 2>&1; then
    PARTIAL="${PARTIAL}hourly snapshots skipped: no python3; "
elif [ -d "$TOC_ROOT/player/versions" ]; then
    python3 - "$TOC_ROOT/player/versions" "$STATE_REPO/player/versions" <<'PY' ||
import os, re, shutil, sys, time
src, dst = sys.argv[1], sys.argv[2]
# "<Name>.<YYYYMMDD>_<HHMMSS>[_NN]": an ordinary save, as snapshot_name_parse
# reads it; a tagged copy has a second dot and never matches.
plain = re.compile(r"^([A-Za-z]{2,12})\.(\d{8})_(\d{2})\d{4}(?:_\d{2,})?$")
running = time.strftime("%Y%m%d%H", time.localtime())   # the stamps' clock
for name in os.listdir(src):
    here = os.path.join(src, name)
    if not os.path.isdir(here):
        continue
    newest = {}
    for f in os.listdir(here):
        m = plain.match(f)
        if not m or m.group(1) != name:
            continue
        hour = m.group(2) + m.group(3)
        if hour >= running:
            continue
        if f > newest.get(hour, ""):
            newest[hour] = f
    keep = set(newest.values())
    there = os.path.join(dst, name)
    if keep:
        os.makedirs(there, exist_ok=True)
    for f in keep:
        a, b = os.path.join(here, f), os.path.join(there, f)
        if not os.path.exists(b) or os.path.getsize(a) != os.path.getsize(b):
            shutil.copy2(a, b)
    if os.path.isdir(there):
        for f in os.listdir(there):
            if plain.match(f) and f not in keep:
                os.remove(os.path.join(there, f))
PY
    {
        # The rest of the state still goes -- a failed hourly copy must not
        # cost the characters their backup -- but the run is not a whole one
        # and says so (review, 2026-11-23: this was a plain "ok").
        echo "hourly snapshots: copy failed; the rest of the sync carries on" >&2
        PARTIAL="${PARTIAL}hourly snapshots not copied; "
    }
fi

# Player corpses (corpses.c): live/ is what lies in the world now, and
# mirrors the host exactly -- a corpse that ended must not come back from
# git on a rebuilt host; history/ is every corpse's first and last state
# and what went in and out, and is never deleted from here.
if [ -d "$TOC_ROOT/corpse" ]; then
    mkdir -p "$STATE_REPO/corpse/live" "$STATE_REPO/corpse/history"
    [ -d "$TOC_ROOT/corpse/live" ] && rsync -a --delete --exclude '*.tmp' \
        "$TOC_ROOT/corpse/live/" "$STATE_REPO/corpse/live/"
    [ -d "$TOC_ROOT/corpse/history" ] && rsync -a --exclude '*.tmp' \
        "$TOC_ROOT/corpse/history/" "$STATE_REPO/corpse/history/"
fi

for f in $STATE_FILES; do
    [ -f "$TOC_ROOT/$f" ] || continue
    mkdir -p "$STATE_REPO/$(dirname "$f")"
    cp "$TOC_ROOT/$f" "$STATE_REPO/$f"
done

# Areas built in game with ANEW: area/built/, the area files and their
# own list (BUILT_AREA_LIST in merc.h). Without this a built area lived on
# the host alone. Each save's dated backup and any temp file stay behind.
# No --delete: a built area missing from the host means something went
# wrong, not that it was retired, and a sync must not delete it from git.
if [ -d "$TOC_ROOT/$BUILT_DIR" ]; then
    mkdir -p "$STATE_REPO/$BUILT_DIR"
    rsync -a --exclude '*.bak' --exclude '*.tmp' \
        "$TOC_ROOT/$BUILT_DIR/" "$STATE_REPO/$BUILT_DIR/"
fi

for f in $REPORT_FILES; do
    for archive in "$TOC_ROOT/$f".*; do
        [ -f "$archive" ] || continue
        cp "$archive" "$STATE_REPO/$f.${archive##*.}"
        git add -f "$f.${archive##*.}"
    done
    # Cleared on the host: retire it here too. Only the report files --
    # a missing custom.are means something is wrong, not that it was
    # cleared, and must never be deleted from git by a sync.
    if [ ! -f "$TOC_ROOT/$f" ] && git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
        git rm --quiet "$f"
    fi
done

# Copied: let a deploy have the tree back before the slow part, the push.
exec 8<&-

# Keep the clone packed. Every run writes the changed logs as new loose
# objects, whole -- the play journal alone is megabytes -- and git's own
# automatic packing stopped keeping up: the clone reached 24 GB of loose
# objects and filled the disk (2026-11-22; the repository on GitHub is
# about 100 MB). Past COMPACT_LOOSE_KB of loose objects it is packed now,
# here, which takes a minute at most; a gc.log left by a failed automatic
# run would otherwise stop git trying again for a day.
COMPACT_LOOSE_KB="${TOC_GIT_COMPACT_KB:-262144}"
loose_kb=$(git count-objects -v 2>/dev/null | awk '/^size:/ {print $2}')
case "$loose_kb" in ''|*[!0-9]*) loose_kb=0 ;; esac
if [ "$loose_kb" -gt "$COMPACT_LOOSE_KB" ]; then
    rm -f .git/gc.log
    echo "packing the clone: $((loose_kb / 1024)) MB of loose objects" >&2
    git gc --quiet --prune=now || echo "git gc failed; the clone keeps growing" >&2
fi

for d in $STATE_DIRS; do
    [ -d "$STATE_REPO/$d" ] && git add -f -A "$d"
done
for f in $STATE_FILES; do
    [ -f "$STATE_REPO/$f" ] && git add -f "$f"
done
[ -d "$STATE_REPO/$BUILT_DIR" ] && git add -f -A "$BUILT_DIR"
[ -d "$STATE_REPO/corpse" ] && git add -f -A corpse

if git diff --cached --quiet && [ "$CARRIED" -eq 0 ]; then
    # Nothing changed -- which is a success only if GitHub holds this tree:
    # the commit the clone was reset to a moment ago, or one built on it.
    STEP=verify
    remote_holds "$(git rev-parse HEAD)" ||
        fail "nothing to commit, but GitHub could not be shown to hold the last state"
    RESULT=nochange
    REASON="nothing changed; GitHub holds the state"
    record_success nochange 0 0
    mirror_push
    [ -n "$override_reason" ] && mv -f "$OVERRIDE" "$OVERRIDE.used-$(date +%s)" 2>/dev/null
    exit 0
fi

STEP=commit
changed=$(git diff --cached --name-only | wc -l)
players=$(git diff --cached --name-only -- player ':(exclude)player/versions' ':(exclude)player/diary' | wc -l)
override_line=""
[ -n "$dropped" ] && override_line="
Drop allowed by override (${dropped# }): $override_reason"
# Only the carried commits to push when nothing new changed.
if ! git diff --cached --quiet; then
    git commit --quiet -m "State sync: $changed files, $players characters [skip ci]

Automatic. Written by toc-state-sync on the host that is running the
game, so that an outage cannot cost more than the interval between
runs.$override_line"
fi

# The branch can move under us between the fetch and the push.
STEP=push
n=0
until git push --quiet origin "$BRANCH" 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -ge 5 ] && fail "push failed after $n attempts"
    sleep $((n * 3))
    git fetch --quiet origin "$BRANCH" || fail "push refused, and the fetch to rebase on failed"
    git rebase --quiet "origin/$BRANCH" || { git rebase --abort; fail "push refused, and the rebase onto GitHub's branch failed"; }
done

STEP=verify
remote_holds "$(git rev-parse HEAD)" ||
    fail "pushed, but GitHub does not show the commit"
RESULT=ok
REASON="pushed $changed files ($players characters)"
[ "$CARRIED" -gt 0 ] && REASON="$REASON and $CARRIED earlier commit(s) a failed push had left"
record_success pushed "$changed" "$players"
mirror_push
[ -n "$override_reason" ] && mv -f "$OVERRIDE" "$OVERRIDE.used-$(date +%s)" 2>/dev/null
echo "pushed $changed files ($players characters)"
