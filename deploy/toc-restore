#!/bin/sh
# Rebuild a working Times of Chaos from GitHub and nothing else.
#
# This is the other half of toc-state-sync. The sync is only worth
# having if somebody can turn what it pushed back into a running game
# on a machine that has never seen this project, so that is what this
# does: clone, build, put the live state where the game expects it,
# and check the world loads.
#
# It deliberately takes no arguments it does not need and assumes
# nothing about the host beyond a Debian-family Linux with the build
# tools. Run it on a bare box after a disk failure and you should have
# the game back with at most the last sync interval missing.
#
#   sudo ./toc-restore                     # into /srv/toc, the usual place
#   TOC_PREFIX=/tmp/drill ./toc-restore    # a rehearsal that touches nothing
#
# A rehearsal is the point of TOC_PREFIX: an untested restore is a
# hope, not a backup, so this is written to be run for practice
# without disturbing anything live.
set -eu

REPO="${REPO:-https://github.com/jeremydbean/toc2026.git}"
BRANCH="${BRANCH:-main}"
TOC_PREFIX="${TOC_PREFIX:-/srv/toc}"
BUILD="$TOC_PREFIX/build"
CURRENT="$TOC_PREFIX/current"
DRILL="${DRILL:-0}"
# Anywhere but /srv/toc is a rehearsal, unless TOC_RESTORE_DRILL=0 says
# otherwise -- the tests' way to run the live path (lock, stop, swap,
# start) in a scratch prefix, always with TOC_RESTORE_SKIP_SERVICES=1.
[ "$TOC_PREFIX" = "/srv/toc" ] || DRILL=${TOC_RESTORE_DRILL:-1}

say() { printf '\n== %s\n' "$*"; }

say "restoring from $REPO ($BRANCH) into $TOC_PREFIX"
[ "$DRILL" = 1 ] && echo "   rehearsal: nothing outside $TOC_PREFIX is touched"

# Everything that can refuse refuses before anything is written. A restore
# under a running game is undone by the game's own saves, and a sync
# mid-restore pushes a half-laid tree (review, 2026-11-23). The game, the
# dashboard and every timer are dealt with below, under the maintenance
# lock; what cannot wait is a target that already holds state, which is
# replaced only on request (TOC_RESTORE_REPLACE=1) and then moved aside
# whole, never deleted.
STAMP=$(date -u +%Y%m%d-%H%M%S)
RESTORE_BEGAN=$(date +%s)
# The name the old tree will have, if it is free; the one it gets is chosen
# at the swap (review, 2026-11-24: a pre-restore-<stamp> already there --
# two restores in one second -- took the live tree *inside* it, and the
# rollback then put back the wrong one).
ASIDE="$TOC_PREFIX/pre-restore-$STAMP"
STAGE="$TOC_PREFIX/.restore-stage-$STAMP-$$"
RESERVE_MB="${TOC_RESTORE_RESERVE_MB:-512}"
held=""

# Free space on the disk the game saves to, in K, against what is about to
# be written there and TOC_RESTORE_RESERVE_MB kept for the game's own saves
# (review, 2026-11-24: the restore built a second whole tree beside a game
# still saving, and a disk it filled would have failed those saves).
room_for() {
    [ "${TOC_RESTORE_SPACE_CHECK:-1}" = 0 ] && return 0
    free=$(df -Pk "$TOC_PREFIX" 2>/dev/null | awk 'NR == 2 {print $4}')
    case "$free" in
        ''|*[!0-9]*)
            echo "   refusing: cannot tell the free space at $TOC_PREFIX ($2); $CURRENT is as it was" >&2
            echo "   (TOC_RESTORE_SPACE_CHECK=0 skips the check, at your own risk)" >&2
            return 1 ;;
    esac
    want=$(( $1 + RESERVE_MB * 1024 ))
    if [ "$free" -lt "$want" ]; then
        echo "   refusing: $2 needs ${1}K, and ${RESERVE_MB}M is kept free for the game's saves;" >&2
        echo "   $TOC_PREFIX has ${free}K free. $CURRENT is as it was." >&2
        return 1
    fi
}
# A path with its directories' symlinks resolved, whether or not it exists.
canonical() {
    if [ -d "$1" ]; then (cd "$1" && pwd -P)
    elif [ -d "$(dirname "$1")" ]; then printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd -P)" "$(basename "$1")"
    else printf '%s\n' "$1"
    fi
}
# Games running from a tree that systemd does not know of -- a merc started
# by hand in its area/ (review, 2026-11-24, third: only toc-game.service was
# asked, and a hand-started game saves over a restore just the same). Reads
# /proc (TOC_PROC, for the tests): each process named merc or rom (the
# CMake build) whose working directory is the tree or under it. Prints their pids; nothing where there
# is no /proc to read, which is a limit: such a host is not checked.
games_running_in() {
    proc=${TOC_PROC:-/proc}
    [ -d "$proc" ] || return 0
    tree=$(canonical "$1")
    for p in "$proc"/[0-9]*; do
        # merc from the Makefile, rom from the CMake build (bin/rom): both
        # save into the tree they run in (review, 2026-11-24).
        name=$(cat "$p/comm" 2>/dev/null) || continue
        case "$name" in merc|rom) ;; *) continue ;; esac
        cwd=$(readlink "$p/cwd" 2>/dev/null) || continue
        [ -d "$cwd" ] && cwd=$(cd "$cwd" 2>/dev/null && pwd -P)
        case "$cwd/" in "$tree"/*) printf '%s ' "$(basename "$p")" ;; esac
    done
}
# A free name for the old tree: $1, else $1-2, $1-3, ... Under the lock (a
# live restore) nothing else makes these, so the name stays free until the
# rename; the rename is checked besides.
free_name() {
    n=1; p=$1
    while [ -e "$p" ] || [ -L "$p" ]; do
        n=$((n + 1)); p="$1-$n"
        [ "$n" -le 1000 ] || return 1
    done
    printf '%s\n' "$p"
}
for d in player gods heroes log corpse; do
    if [ -d "$CURRENT/$d" ] && [ -n "$(ls -A "$CURRENT/$d" 2>/dev/null)" ]; then
        held="$held $d"
    fi
done
if [ -n "$held" ] && [ "${TOC_RESTORE_REPLACE:-0}" != 1 ]; then
    echo "   refusing: $CURRENT already holds state:$held" >&2
    echo "   A restore over it would keep files the backup does not have (a" >&2
    echo "   character deleted since, a corpse that has ended). To replace it," >&2
    echo "   set TOC_RESTORE_REPLACE=1: the whole tree is moved to $ASIDE," >&2
    echo "   not deleted." >&2
    exit 3
fi

# The maintenance lock, before $BUILD is touched: it is toc-deploy's
# checkout too, and a deploy running beside this would fetch, reset and
# build in it at the same time (review, 2026-11-24). Held to the end. While
# it is held the sync skips -- the state it would push is about to be
# replaced, and the old tree is kept whole in pre-restore-<stamp>/.
OWN_LOCK=""
if [ "$DRILL" = 0 ] && [ -z "${TOC_DEPLOY_LOCKED:-}" ]; then
    exec 9>"${TOC_DEPLOY_LOCK:-/run/toc-deploy.lock}"
    if ! flock -w "${TOC_RESTORE_LOCK_WAIT:-300}" 9; then
        echo "   refusing: the maintenance lock is still held (a deploy?); $CURRENT is as it was" >&2
        exit 2
    fi
    export TOC_DEPLOY_LOCKED=1
    OWN_LOCK=1
fi

# ---------------------------------------------------------------- clone
say "fetching the repository"
mkdir -p "$TOC_PREFIX"
room_for 0 "fetching" || exit 5
if [ -d "$BUILD/.git" ]; then
    git -C "$BUILD" fetch --quiet origin "$BRANCH"
    git -C "$BUILD" reset --quiet --hard "origin/$BRANCH"
else
    git clone --quiet --branch "$BRANCH" "$REPO" "$BUILD"
fi
echo "   at $(git -C "$BUILD" rev-parse --short HEAD)"

# ------------------------------------------------------------- the state
# The saves, the note board and the reports come down with the clone,
# because toc-state-sync commits them. That is the whole point: there
# is no second archive to find and no key to have kept.
say "checking the live state came with it"
# grep -c prints 0 itself when nothing matches -- and exits 1, so the
# old `|| echo 0` made the count "0<newline>0", the test below errored
# instead of failing, and a repository with no characters was restored
# as if it had some (audit, 2026-10-22). wc always prints a number.
players=$(ls "$BUILD/player" 2>/dev/null | grep -cv '^versions$' || true)
gods=$(ls "$BUILD/gods" 2>/dev/null | wc -l | tr -d ' ')
echo "   $players characters, $gods gods files"
case "$players" in
    ''|*[!0-9]*) players=0 ;;
esac
if [ "$players" -lt 1 ]; then
    echo "   NO CHARACTERS IN THE REPOSITORY -- stopping." >&2
    echo "   Either the sync was never running or the wrong branch is checked out." >&2
    exit 1
fi
newest=$(git -C "$BUILD" log -1 --format=%cI -- player gods 2>/dev/null || echo unknown)
echo "   state last committed: $newest"

# ---------------------------------------------------------------- build
say "building"
make -C "$BUILD" clean >/dev/null 2>&1 || true
if ! make -C "$BUILD" >/tmp/toc-restore-build.log 2>&1; then
    echo "   build failed; see /tmp/toc-restore-build.log" >&2
    tail -15 /tmp/toc-restore-build.log >&2
    exit 1
fi
echo "   built $(ls -la "$BUILD/merc" | awk '{print $5}') bytes"

# ------------------------------------------------------------ world check
say "checking the world loads"
# Not piped into tail: /bin/sh has no pipefail, so the pipe's status was
# tail's and a world that would not load passed (audit, 2026-10-21).
if ( cd "$BUILD/area" && ../merc --check-area ) >/tmp/toc-restore-check.log 2>&1; then
    tail -1 /tmp/toc-restore-check.log
else
    echo "   the world did not validate; see /tmp/toc-restore-check.log" >&2
    tail -15 /tmp/toc-restore-check.log >&2
    exit 1
fi

# --------------------------------------------------------------- install
# Review, 2026-11-24: the install used to rsync the code straight over the
# live tree and only then ask toc-restore-state about the state, which
# could still refuse or fail -- leaving new code over old state, or a tree
# half laid. Now the whole new tree is built beside the live one first,
# code and state, and checked; nothing live is touched until it is whole.
# Then, under the maintenance lock every other writer defers to
# (/run/toc-deploy.lock: toc-state-sync from its timer or its path unit
# skips, toc-auto-deploy waits, toc-game-recovery neither restarts the game
# nor turns a timer back on), the game and dashboard are stopped and the
# two trees swapped by rename: the old one to $ASIDE, whole, the new one
# into its place. A step that fails puts the old tree back and starts what
# was running again.
say "staging the new tree beside $CURRENT"
# The staged tree is the checkout without .git: code and state, once each.
whole=$(du -sk "$BUILD" 2>/dev/null | awk '{print $1}')
dotgit=$(du -sk "$BUILD/.git" 2>/dev/null | awk '{print $1}')
room_for $(( ${whole:-0} - ${dotgit:-0} )) "staging the new tree" || exit 5
rm -rf "$STAGE"
mkdir -p "$STAGE"
abandon() { rm -rf "$STAGE"; echo "   $*; $CURRENT is as it was" >&2; exit 1; }
# The code; the state is laid down on its own below, never merged in here.
rsync -a --exclude '.git/' --exclude '/player/' --exclude '/gods/' --exclude '/heroes/' \
      --exclude '/log/' --exclude '/corpse/' "$BUILD/" "$STAGE/" ||
    abandon "copying the code into the staging tree failed"
# These are written by the running game and are not code; they come
# from the repository on a restore because that is the only copy. The
# helper beside this script first: restoring an older commit, from
# before the helper existed, must still lay its state down this way.
RESTORE_STATE="$(dirname "$0")/toc-restore-state"
[ -f "$RESTORE_STATE" ] || RESTORE_STATE="$BUILD/deploy/toc-restore-state"
VERIFY="$(dirname "$0")/toc-restore-verify"
[ -f "$VERIFY" ] || VERIFY="$BUILD/deploy/toc-restore-verify"
# The verdict on the units and on the backups (review, 2026-11-24, fourth):
# the backups judged as toc-state-sync.service runs -- user toc, HOME the
# prefix -- by a sync that has reached GitHub since this restore began,
# not by push access alone. sync_once runs one, as the timer would.
# TOC_RESTORE_BACKUP_CHECK=0 leaves the backups out (tests of other things).
verify_all() {
    if [ "${TOC_RESTORE_BACKUP_CHECK:-1}" = 0 ]; then
        sh "$VERIFY" "$@"
    else
        sh "$VERIFY" --backup-key "${GIT_SSH_KEY:-$TOC_PREFIX/.ssh/id_ed25519_state_sync}" \
            --backup-remote "${TOC_STATE_REMOTE:-git@github.com:jeremydbean/toc2026.git}" \
            --as toc --home "$TOC_PREFIX" \
            --sync-receipts "${TOC_SYNC_STATE_DIR:-/var/lib/toc-state-sync}" \
            --since "${SWAPPED_AT:-$RESTORE_BEGAN}" \
            --state-repo "${STATE_REPO:-$TOC_PREFIX/state-repo}" --tree "$CURRENT" "$@"
    fi
}
# Review, 2026-11-27: this started the sync while still holding the
# maintenance lock -- which the sync takes shared, and skips without -- so
# the sync never ran and the verdict could not be met; and a receipt
# written after the restore began but before the swap would have been
# taken for one of the restored state. The restore is done by now, so its
# own hold on the lock is let go first, and the receipt must be from after
# the swap (SWAPPED_AT) and match the restored tree (toc-restore-verify).
sync_once() {
    [ "${TOC_RESTORE_BACKUP_CHECK:-1}" = 0 ] && return 0
    if [ -n "$OWN_LOCK" ]; then
        flock -u 9 2>/dev/null || true
        exec 9>&-
        OWN_LOCK=""
        unset TOC_DEPLOY_LOCKED
        echo "   the restore is done: the maintenance lock is let go for the sync"
    elif [ -n "${TOC_DEPLOY_LOCKED:-}" ]; then
        echo "   WARN: the caller holds the maintenance lock, so the sync skips until it is let go" >&2
    fi
    echo "   running one state sync, to prove the restored state reaches GitHub..."
    systemctl start toc-state-sync.service >/dev/null 2>&1 || true
}
TOC_RESTORE_LIVE=0 sh "$RESTORE_STATE" "$BUILD" "$STAGE" ||
    abandon "laying the state into the staging tree failed"
# corpse/ comes from git too since corpses are written down (corpses.c):
# the players' corpses lying in the world when the host was lost are made
# again at boot, and player/recovery/ -- the restore receipts and player
# identities -- came with player/. backups/ is genuinely empty on a new
# box (on an old one it is carried across below); heroes/ is not, and
# creating it empty here is how a restored game got a blank plaque.
# area/shutdown.txt is tracked in git but is a runtime marker: when it
# exists, toc-game.service's ExecCondition skips the start and the game
# comes up dead. toc-deploy rm's it for the same reason.
rm -f "$STAGE/area/shutdown.txt" "$STAGE/area/shutdown"
[ -x "$STAGE/merc" ] || abandon "the staging tree has no game binary"

stopped=""
if [ "$DRILL" = 0 ]; then
    if command -v systemctl >/dev/null 2>&1; then
        for unit in toc-game.service toc-web.service; do
            if systemctl is-active --quiet "$unit" 2>/dev/null; then
                systemctl stop "$unit" || {
                    for u in $stopped; do systemctl start "$u" || true; done
                    abandon "could not stop $unit"
                }
                stopped="$stopped $unit"
            fi
        done
    fi
fi
resume() {
    for u in $stopped; do
        systemctl start "$u" || echo "   COULD NOT START $u again -- start it by hand" >&2
    done
}
# A game systemd did not start would still be saving into $CURRENT.
running=$(games_running_in "$CURRENT")
if [ -n "$running" ]; then
    resume; abandon "a game is running from $CURRENT that systemd did not start (merc or rom, pid $running); stop it first"
fi
# What the old tree holds that the checkout does not -- the game's runtime
# files under area/, a build's leftovers -- is kept, as the old rsync over
# the live tree kept it; taken now, with the game stopped, so it is final.
if [ -d "$CURRENT" ] &&
   ! rsync -a --ignore-existing --exclude '/player/' --exclude '/gods/' \
         --exclude '/heroes/' --exclude '/log/' --exclude '/corpse/' \
         --exclude '/backups/' --exclude '/.code-revision' \
         --exclude '/area/shutdown.txt' --exclude '/area/shutdown' \
         "$CURRENT/" "$STAGE/"; then
    resume; abandon "carrying the old tree's runtime files across failed"
fi
say "swapping it in"
aside_made=""
if [ -e "$CURRENT" ]; then
    ASIDE=$(free_name "$ASIDE") || { resume; abandon "no free name to move the old tree aside to"; }
    mv "$CURRENT" "$ASIDE" || { resume; abandon "moving the old tree aside failed"; }
    # A name taken between the choice and the rename would have taken the
    # tree inside it: then $CURRENT is still gone and $ASIDE/current holds it.
    if [ -e "$CURRENT" ] || [ -e "$ASIDE/$(basename "$CURRENT")/player" ]; then
        [ -e "$CURRENT" ] || mv "$ASIDE/$(basename "$CURRENT")" "$CURRENT"
        resume; abandon "the old tree did not move aside to a name of its own"
    fi
    aside_made=1
fi
if ! mv "$STAGE" "$CURRENT"; then
    [ -n "$aside_made" ] && mv "$ASIDE" "$CURRENT"
    resume; abandon "moving the new tree in failed; the old one is back"
fi
SWAPPED_AT=$(date +%s)      # a sync's receipt counts only from here
if [ -n "$aside_made" ] && [ -d "$ASIDE/backups" ]; then
    rmdir "$CURRENT/backups" 2>/dev/null || true
    mv "$ASIDE/backups" "$CURRENT/backups" ||
        echo "   WARN: the game's own archives stayed at $ASIDE/backups" >&2
fi
mkdir -p "$CURRENT/backups"
[ -n "$aside_made" ] && echo "   the old tree is at $ASIDE (nothing deleted)"
echo "   $(find "$CURRENT/player" -mindepth 1 -maxdepth 1 -type f | wc -l | tr -d ' ') characters, $(ls "$CURRENT/heroes" | wc -l | tr -d ' ') heroes in place"

# On a host whose units are already installed and wired -- a restore of
# the state on the machine that holds it -- TOC_RESTORE_SKIP_SERVICES=1
# starts again what was stopped and leaves the units alone.
if [ "$DRILL" = 0 ] && [ "${TOC_RESTORE_SKIP_SERVICES:-0}" = 1 ]; then
    printf '%s %s\n' "$(git -C "$BUILD" rev-parse HEAD)" \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$CURRENT/log/deployed-commit" 2>/dev/null || true
    if [ "$(id -u)" = 0 ] && id -u toc >/dev/null 2>&1; then
        chown -R toc:toc "$CURRENT"      # the game runs as toc and must write it
    fi
    resume
    # Started is not running: prove it, or say so (review, 2026-11-24) --
    # and the backups too: the restored state is only safe once a sync has
    # carried it to GitHub (review, 2026-11-24, fourth).
    sync_once
    verified=0
    verify_all --active-only $stopped || verified=$?
    if [ "$verified" != 0 ] && [ "$verified" != 3 ]; then
        say "RESTORE NOT COMPLETE -- the tree is restored, but what was running is not running again"
        echo "   see above; the old tree is at $ASIDE" >&2
        exit 4
    fi
    if [ "$verified" = 3 ]; then
        say "GAME RUNNING, BACKUPS NOT VERIFIED -- the tree is restored and running, but no"
        echo "   state sync has reached GitHub since; see above. The old tree is at $ASIDE." >&2
        exit 6
    fi
    say "done -- the tree is restored, what was running is started again, and backups verified"
    exit 0
fi

if [ "$DRILL" = 1 ]; then
    say "rehearsal complete"
    echo "A real restore would now: create the toc user, build the venv,"
    echo "install every systemd unit (game, web, sync, recovery) with a"
    echo "fresh web-admin token, and enable + start the game so it comes"
    echo "back on crash and on boot. Two things still need a human: open"
    echo "the game port in the host firewall, and drop the state-sync"
    echo "deploy key at /srv/toc/.ssh/id_ed25519_state_sync."
    exit 0
fi

# ------------------------------------------------------------- services
say "wiring up the services"
id -u toc >/dev/null 2>&1 || useradd --system --home "$TOC_PREFIX" --shell /usr/sbin/nologin toc
mkdir -p /etc/toc /var/log/toc /var/backups/toc

# Every unit, not just the sync. The game and dashboard units are in the
# repository now, so a bare-box restore brings up a *running* game rather
# than leaving the service layer to be rebuilt by hand -- which is how the
# Oracle migration left the host until this was fixed.
for u in toc-game.service toc-web.service \
         toc-state-sync.service toc-state-sync.timer toc-state-sync.path \
         toc-state-sync-check.service toc-state-sync-check.timer \
         toc-game-recovery.service toc-game-recovery.timer \
         toc-auto-deploy.service toc-auto-deploy.timer \
         toc-host-action.service toc-host-action.path \
         toc-heartbeat.service toc-heartbeat.timer; do
    [ -f "$BUILD/deploy/windows-vm/$u" ] && install -m 0644 "$BUILD/deploy/windows-vm/$u" /etc/systemd/system/
done
for s in toc-deploy toc-state-sync toc-state-sync-check toc-game-recovery toc-auto-deploy \
         toc-game-probe toc-host-action toc-ops-summary; do
    [ -f "$BUILD/deploy/windows-vm/$s" ] && install -m 0755 "$BUILD/deploy/windows-vm/$s" /usr/local/sbin/
done

# The dashboard's virtualenv.
if [ ! -x "$TOC_PREFIX/venv/bin/python" ]; then
    if python3 -m venv "$TOC_PREFIX/venv" 2>/dev/null; then
        "$TOC_PREFIX/venv/bin/pip" install --quiet --upgrade pip || true
        "$TOC_PREFIX/venv/bin/pip" install --quiet -r "$BUILD/webadmin/requirements.txt" || true
    else
        echo "   WARN: no python3-venv; dashboard will not start until a venv exists at $TOC_PREFIX/venv" >&2
    fi
fi

# A fresh web-admin token, generated here so the value never leaves the
# host -- but only when none is already present, never clobbering a live
# one. Nothing in the game depends on the old value.
if [ ! -f /etc/toc/web.env ]; then
    ( umask 077
      {
        printf 'WEB_ADMIN_TOKEN=%s\n' "$(openssl rand -hex 32)"
        printf 'WEB_ADMIN_LOCAL_UNLOCK=0\n'
        printf 'WEB_ADMIN_HOST_STATUS=1\n'
        printf 'TOC_HOST_SERVICE_UNITS=toc-game.service toc-web.service toc-state-sync.service toc-state-sync-check.service toc-game-recovery.service\n'
        printf 'TOC_HOST_TIMER_UNITS=toc-state-sync.timer toc-state-sync-check.timer toc-game-recovery.timer\n'
        printf 'TOC_HOST_JOURNAL_UNITS=toc-game.service toc-web.service toc-state-sync.service\n'
      } > /etc/toc/web.env )
fi

chown -R toc:toc "$TOC_PREFIX" /var/log/toc /var/backups/toc

# Review, 2026-11-24: every enable here ended `|| true` and the script said
# the game was up whatever happened. A failure is now kept, and the game and
# the backup units are proved active at the end, or the restore says it is
# not complete and exits 4.
not_enabled=""
systemctl daemon-reload || not_enabled="$not_enabled (daemon-reload)"
# Enabled, not just started: the game has to come back on its own after a
# crash (Restart=always) and after a reboot (enabled). The recovery timer
# is the backstop if it ever crash-loops past systemd's start limit.
systemctl enable --now toc-game.service toc-web.service || not_enabled="$not_enabled toc-game.service/toc-web.service"
systemctl enable --now toc-state-sync.timer toc-state-sync.path toc-state-sync-check.timer toc-game-recovery.timer ||
    not_enabled="$not_enabled the-backup-units"
# The admin website's maintenance actions (deploy/windows-vm/toc-host-action):
# results in root's directory, readable by the dashboard's group.
install -d -m 0750 -o root -g toc /var/lib/toc-host-actions 2>/dev/null || true
systemctl enable --now toc-host-action.path || not_enabled="$not_enabled toc-host-action.path"
# The restore is the first deploy: record it, so toc-auto-deploy has a
# live commit to compare main against, then let it take over.
printf '%s %s\n' "$(git -C "$BUILD" rev-parse HEAD)" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$TOC_PREFIX/current/log/deployed-commit" 2>/dev/null || true
# And the tree's own name for its code, as toc-deploy's install writes it,
# so the first deploy's snapshot of this tree can be rolled back to by
# commit rather than as unknown.
printf '%s %s\n' "$(git -C "$BUILD" rev-parse HEAD)" \
    "$(sha256sum "$TOC_PREFIX/current/merc" 2>/dev/null | cut -d' ' -f1)" \
    > "$TOC_PREFIX/current/.code-revision" 2>/dev/null || true
systemctl enable --now toc-auto-deploy.timer || not_enabled="$not_enabled toc-auto-deploy.timer"
# The operations summary and heartbeat.
systemctl enable --now toc-heartbeat.timer || not_enabled="$not_enabled toc-heartbeat.timer"
# Every support unit, proved loaded from what was just installed.
sh "$BUILD/deploy/windows-vm/toc-install-units" "$BUILD/deploy/windows-vm" ||
    echo "   WARN: support units not verified; run toc-ops-summary" >&2

# The game and the backups must be running: a restore that brings back a
# game nobody can reach, or one whose saves never reach GitHub again, is
# not done. The rest are wanted, and named if they are not.
[ -n "$not_enabled" ] && echo "   systemctl enable failed for:$not_enabled" >&2
# Review, 2026-11-24 (third): the game running and backups reaching GitHub
# are two verdicts. A fresh host has no deploy key, so its sync runs and
# fails every minute; that is reported, not called done.
verified=0
sync_once
verify_all toc-game.service toc-state-sync.timer toc-state-sync.path \
        toc-state-sync-check.timer toc-game-recovery.timer \
        -- toc-web.service toc-auto-deploy.timer toc-heartbeat.timer toc-host-action.path ||
    verified=$?
if [ "$verified" != 0 ] && [ "$verified" != 3 ]; then
    say "RESTORE NOT COMPLETE -- the tree is in place, but the units named above are not running"
    echo "   Fix what journalctl -u <unit> says, then: systemctl enable --now <unit>." >&2
    echo "   The old tree, if there was one, is at $ASIDE." >&2
    exit 4
fi

cat <<'NOTE'

   The game is installed and set to restart on crash and on boot. Two
   things still need a human, because both are credentials:
     - open the game port (9000) in the host firewall. On an OCI Ubuntu
       box that is an iptables ACCEPT inserted before the REJECT rule and
       saved with netfilter-persistent -- the VCN security list alone is
       not enough. Most other hosts (Linode and the like) need nothing.
     - put the state-sync deploy key at
       /srv/toc/.ssh/id_ed25519_state_sync (owned by toc, mode 600), its
       public half added to the repo as a deploy key with write access.
       Until it is there the game runs but backups do not resume.

   The website comes up on public port 9001 (http). To put it back
   behind Caddy at https://timesofchaos.com on 80 and 443, with the
   dashboard on 127.0.0.1:9001, run once:
       sudo sh /srv/toc/build/deploy/windows-vm/toc-web-proxy
   (DNS for timesofchaos.com and www must point at this machine, and
   TCP 80 and 443 be open in the provider's firewall, for its
   certificate; see wiki/disaster-recovery.md.)
NOTE

if [ "$verified" = 3 ]; then
    say "GAME RUNNING, BACKUPS NOT VERIFIED -- the game is up and restarts itself, but its"
    echo "   saves have not reached GitHub since the restore: put the deploy key in place" >&2
    echo "   (above), run a sync (systemctl start toc-state-sync.service), then check:" >&2
    echo "     sh $VERIFY --backup-key <key> --backup-remote <remote> --as toc --home $TOC_PREFIX \\" >&2
    echo "        --sync-receipts /var/lib/toc-state-sync --since ${SWAPPED_AT:-$RESTORE_BEGAN} \\" >&2
    echo "        --state-repo $TOC_PREFIX/state-repo --tree $CURRENT toc-game.service" >&2
    exit 6
fi
say "done -- game is up and self-restarting, and backups verified; see the manual steps above"
