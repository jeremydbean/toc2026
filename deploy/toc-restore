#!/bin/sh
# Rebuild a working Times of Chaos from GitHub and nothing else.
#
# This is the other half of toc-state-sync. The sync is only worth
# having if somebody can turn what it pushed back into a running game
# on a machine that has never seen this project, so that is what this
# does: clone, build, put the live state where the game expects it,
# and check the world loads.
#
# It deliberately takes no arguments it does not need and assumes
# nothing about the host beyond a Debian-family Linux with the build
# tools. Run it on a bare box after a disk failure and you should have
# the game back with at most the last sync interval missing.
#
#   sudo ./toc-restore                     # into /srv/toc, the usual place
#   TOC_PREFIX=/tmp/drill ./toc-restore    # a rehearsal that touches nothing
#
# A rehearsal is the point of TOC_PREFIX: an untested restore is a
# hope, not a backup, so this is written to be run for practice
# without disturbing anything live.
set -eu

REPO="${REPO:-https://github.com/jeremydbean/toc2026.git}"
BRANCH="${BRANCH:-main}"
TOC_PREFIX="${TOC_PREFIX:-/srv/toc}"
BUILD="$TOC_PREFIX/build"
CURRENT="$TOC_PREFIX/current"
DRILL="${DRILL:-0}"
[ "$TOC_PREFIX" = "/srv/toc" ] || DRILL=1

say() { printf '\n== %s\n' "$*"; }

say "restoring from $REPO ($BRANCH) into $TOC_PREFIX"
[ "$DRILL" = 1 ] && echo "   rehearsal: nothing outside $TOC_PREFIX is touched"

# ---------------------------------------------------------------- clone
say "fetching the repository"
mkdir -p "$TOC_PREFIX"
if [ -d "$BUILD/.git" ]; then
    git -C "$BUILD" fetch --quiet origin "$BRANCH"
    git -C "$BUILD" reset --quiet --hard "origin/$BRANCH"
else
    git clone --quiet --branch "$BRANCH" "$REPO" "$BUILD"
fi
echo "   at $(git -C "$BUILD" rev-parse --short HEAD)"

# ------------------------------------------------------------- the state
# The saves, the note board and the reports come down with the clone,
# because toc-state-sync commits them. That is the whole point: there
# is no second archive to find and no key to have kept.
say "checking the live state came with it"
players=$(ls "$BUILD/player" 2>/dev/null | grep -cv '^versions$' || echo 0)
gods=$(ls "$BUILD/gods" 2>/dev/null | wc -l || echo 0)
echo "   $players characters, $gods gods files"
if [ "$players" -lt 1 ]; then
    echo "   NO CHARACTERS IN THE REPOSITORY -- stopping." >&2
    echo "   Either the sync was never running or the wrong branch is checked out." >&2
    exit 1
fi
newest=$(git -C "$BUILD" log -1 --format=%cI -- player gods 2>/dev/null || echo unknown)
echo "   state last committed: $newest"

# ---------------------------------------------------------------- build
say "building"
make -C "$BUILD" clean >/dev/null 2>&1 || true
if ! make -C "$BUILD" >/tmp/toc-restore-build.log 2>&1; then
    echo "   build failed; see /tmp/toc-restore-build.log" >&2
    tail -15 /tmp/toc-restore-build.log >&2
    exit 1
fi
echo "   built $(ls -la "$BUILD/merc" | awk '{print $5}') bytes"

# ------------------------------------------------------------ world check
say "checking the world loads"
if ( cd "$BUILD/area" && ../merc --check-area 2>&1 | tail -1 ); then
    :
else
    echo "   the world did not validate" >&2
    exit 1
fi

# --------------------------------------------------------------- install
say "installing to $CURRENT"
mkdir -p "$CURRENT"
rsync -a --exclude '.git/' "$BUILD/" "$CURRENT/"
# These are written by the running game and are not code; they come
# from the repository on a restore because that is the only copy.
for d in player gods heroes log; do
    [ -d "$BUILD/$d" ] && { mkdir -p "$CURRENT/$d"; rsync -a "$BUILD/$d/" "$CURRENT/$d/"; }
done
# corpse/ and backups/ are genuinely empty on a new box; heroes/ is not,
# and creating it empty here is how a restored game got a blank plaque.
mkdir -p "$CURRENT/corpse" "$CURRENT/heroes" "$CURRENT/backups"
echo "   $(ls "$CURRENT/player" | wc -l) characters, $(ls "$CURRENT/heroes" | wc -l) heroes in place"

# area/shutdown.txt is tracked in git but is a runtime marker: when it
# exists, toc-game.service's ExecCondition skips the start and the game
# comes up dead. The wholesale rsync above brings it down from the
# checkout, so a bare-box restore boots to nothing until it is removed.
# toc-deploy rm's it for the same reason; recovery has to as well.
rm -f "$CURRENT/area/shutdown.txt" "$CURRENT/area/shutdown"

if [ "$DRILL" = 1 ]; then
    say "rehearsal complete"
    echo "A real restore would now: create the toc user, build the venv,"
    echo "install every systemd unit (game, web, sync, recovery) with a"
    echo "fresh web-admin token, and enable + start the game so it comes"
    echo "back on crash and on boot. Two things still need a human: open"
    echo "the game port in the host firewall, and drop the state-sync"
    echo "deploy key at /srv/toc/.ssh/id_ed25519_state_sync."
    exit 0
fi

# ------------------------------------------------------------- services
say "wiring up the services"
id -u toc >/dev/null 2>&1 || useradd --system --home "$TOC_PREFIX" --shell /usr/sbin/nologin toc
mkdir -p /etc/toc /var/log/toc /var/backups/toc

# Every unit, not just the sync. The game and dashboard units are in the
# repository now, so a bare-box restore brings up a *running* game rather
# than leaving the service layer to be rebuilt by hand -- which is how the
# Oracle migration left the host until this was fixed.
for u in toc-game.service toc-web.service \
         toc-state-sync.service toc-state-sync.timer \
         toc-state-sync-check.service toc-state-sync-check.timer \
         toc-game-recovery.service toc-game-recovery.timer \
         toc-auto-deploy.service toc-auto-deploy.timer; do
    [ -f "$BUILD/deploy/windows-vm/$u" ] && install -m 0644 "$BUILD/deploy/windows-vm/$u" /etc/systemd/system/
done
for s in toc-deploy toc-state-sync toc-state-sync-check toc-game-recovery toc-auto-deploy; do
    [ -f "$BUILD/deploy/windows-vm/$s" ] && install -m 0755 "$BUILD/deploy/windows-vm/$s" /usr/local/sbin/
done

# The dashboard's virtualenv.
if [ ! -x "$TOC_PREFIX/venv/bin/python" ]; then
    if python3 -m venv "$TOC_PREFIX/venv" 2>/dev/null; then
        "$TOC_PREFIX/venv/bin/pip" install --quiet --upgrade pip || true
        "$TOC_PREFIX/venv/bin/pip" install --quiet -r "$BUILD/webadmin/requirements.txt" || true
    else
        echo "   WARN: no python3-venv; dashboard will not start until a venv exists at $TOC_PREFIX/venv" >&2
    fi
fi

# A fresh web-admin token, generated here so the value never leaves the
# host -- but only when none is already present, never clobbering a live
# one. Nothing in the game depends on the old value.
if [ ! -f /etc/toc/web.env ]; then
    ( umask 077
      {
        printf 'WEB_ADMIN_TOKEN=%s\n' "$(openssl rand -hex 32)"
        printf 'WEB_ADMIN_LOCAL_UNLOCK=0\n'
        printf 'WEB_ADMIN_HOST_STATUS=1\n'
        printf 'TOC_HOST_SERVICE_UNITS=toc-game.service toc-web.service toc-state-sync.service toc-state-sync-check.service toc-game-recovery.service\n'
        printf 'TOC_HOST_TIMER_UNITS=toc-state-sync.timer toc-state-sync-check.timer toc-game-recovery.timer\n'
        printf 'TOC_HOST_JOURNAL_UNITS=toc-game.service toc-web.service toc-state-sync.service\n'
      } > /etc/toc/web.env )
fi

chown -R toc:toc "$TOC_PREFIX" /var/log/toc /var/backups/toc

systemctl daemon-reload || true
# Enabled, not just started: the game has to come back on its own after a
# crash (Restart=always) and after a reboot (enabled). The recovery timer
# is the backstop if it ever crash-loops past systemd's start limit.
systemctl enable --now toc-game.service toc-web.service 2>/dev/null || true
systemctl enable --now toc-state-sync.timer toc-state-sync-check.timer toc-game-recovery.timer 2>/dev/null || true
# The restore is the first deploy: record it, so toc-auto-deploy has a
# live commit to compare main against, then let it take over.
printf '%s %s\n' "$(git -C "$BUILD" rev-parse HEAD)" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$TOC_PREFIX/current/log/deployed-commit" 2>/dev/null || true
systemctl enable --now toc-auto-deploy.timer 2>/dev/null || true

cat <<'NOTE'

   The game is installed and set to restart on crash and on boot. Two
   things still need a human, because both are credentials:
     - open the game port (9000) in the host firewall. On an OCI Ubuntu
       box that is an iptables ACCEPT inserted before the REJECT rule and
       saved with netfilter-persistent -- the VCN security list alone is
       not enough. Most other hosts (Linode and the like) need nothing.
     - put the state-sync deploy key at
       /srv/toc/.ssh/id_ed25519_state_sync (owned by toc, mode 600), its
       public half added to the repo as a deploy key with write access.
       Until it is there the game runs but backups do not resume.
NOTE

say "done -- game is up and self-restarting; see the two manual steps above"
