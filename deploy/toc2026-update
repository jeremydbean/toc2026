#!/bin/sh
set -eu

TOC_ROOT=/home/toc/toc2026
DEPLOYED_COMMIT_FILE=/var/lib/toc2026/deployed-commit
REQUEST_FILE=/run/toc2026/update.request
LOCK_FILE=/run/lock/toc2026-update.lock
SLEEP=${TOC_SLEEP:-/bin/sleep}
TIMEOUT=${TOC_TIMEOUT:-/usr/bin/timeout}

install -d -m 0755 /var/lib/toc2026
rm -f "$REQUEST_FILE"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "Another ToC update is already running; skipping."
    exit 0
fi

run_toc()
{
    runuser -u toc -- "$@"
}

fetch_attempt=1
while :; do
    if run_toc "$TIMEOUT" 2m git -C "$TOC_ROOT" \
        -c http.lowSpeedLimit=1 -c http.lowSpeedTime=60 \
        fetch --prune origin main; then
        break
    fi
    if [ "$fetch_attempt" -ge 3 ]; then
        echo "Unable to fetch origin/main after $fetch_attempt attempts." >&2
        exit 1
    fi
    echo "GitHub fetch attempt $fetch_attempt failed; retrying shortly." >&2
    fetch_attempt=$((fetch_attempt + 1))
    "$SLEEP" 15
done
remote_commit="$(run_toc git -C "$TOC_ROOT" rev-parse origin/main)"
current_commit="$(run_toc git -C "$TOC_ROOT" rev-parse HEAD)"
deployed_commit="$(cat "$DEPLOYED_COMMIT_FILE" 2>/dev/null || true)"

if [ "${TOC_UPDATE_FORCE:-0}" != "1" ] \
   && [ "$current_commit" = "$remote_commit" ] \
   && [ "$deployed_commit" = "$remote_commit" ]; then
    echo "ToC is already current at $remote_commit."
    exit 0
fi

# Files the game itself rewrites while it runs. They are tracked in git as
# seed data, so a live server always shows them as modified -- ban lists,
# the note board, bug and idea reports, PK standings, max-load state. They
# are not a reason to refuse an update, and reverting them would throw away
# live state.
#
# area/custom.are is the same kind of file: RSAVE writes rooms built in
# game into it, and each save leaves a timestamped .bak beside it. Those
# backups are a builder's undo, so they are ignored here rather than
# treated as a reason to stop deploying.
dirty_paths="$(run_toc git -C "$TOC_ROOT" status --porcelain --untracked-files=normal \
    | awk '{print $2}' \
    | grep -Ev '^(player/|gods/|heroes/|backups/|corpse/|log/|area/(shutdown|webadmin)\.queue$|area/custom\.are$|area/[A-Za-z0-9_]+\.are\.([0-9]+\.bak|tmp)$|area/(shutdown|ban|bugs|ideas|typos|notes|maxload|wizlist|offense|relics|not|pkilldata)\.txt$)' || true)"
if [ -n "$dirty_paths" ]; then
    echo "Refusing to update because non-runtime files have local changes:" >&2
    printf '%s\n' "$dirty_paths" >&2
    exit 1
fi

if [ "$current_commit" != "$remote_commit" ]; then
    if ! run_toc git -C "$TOC_ROOT" merge-base --is-ancestor HEAD origin/main; then
        echo "Refusing to update: the local branch cannot fast-forward to origin/main." >&2
        exit 1
    fi
fi

if ! systemctl is-enabled --quiet toc2026-player-backup.timer; then
    echo "Refusing to update because encrypted player backups are not enabled." >&2
    exit 1
fi
systemctl reset-failed toc2026-player-backup.service
systemctl start toc2026-player-backup.service

if [ "$current_commit" != "$remote_commit" ]; then
    run_toc git -C "$TOC_ROOT" merge --ff-only origin/main
fi

# Build and validate before interrupting the live services. A failed build leaves
# the already-running game and dashboard untouched, and the timer retries later.
run_toc make -C "$TOC_ROOT" clean
run_toc make -C "$TOC_ROOT" -j1
(
    cd "$TOC_ROOT/area"
    run_toc ../merc --check-area
)
run_toc "$TOC_ROOT/.venv/bin/python" -m pip install \
    --disable-pip-version-check --timeout 30 --retries 2 --only-binary=:all: \
    -r "$TOC_ROOT/webadmin/requirements.txt"

for script in "$TOC_ROOT"/deploy/toc2026-* \
    "$TOC_ROOT/deploy/install-pi.sh" \
    "$TOC_ROOT/deploy/sync-player-backup.sh"; do
    if [ -f "$script" ]; then
        run_toc /bin/sh -n "$script"
    fi
done
(
    cd "$TOC_ROOT"
    run_toc .venv/bin/python -m compileall -q webadmin
    run_toc .venv/bin/python -m unittest \
        tests.test_webadmin_api tests.test_installation_assets
)

# Refresh root-owned scripts and unit files only after the source, native world,
# dashboard, and deployment assets have all validated. This makes future
# resilience fixes self-deploying instead of requiring a separate SSH session.
"$TOC_ROOT/deploy/install-pi.sh" --refresh

systemctl stop toc2026-web.service
systemctl stop toc2026-game.service
systemctl reset-failed toc2026-game.service toc2026-web.service
systemctl start toc2026-game.service
systemctl start toc2026-web.service

attempt=0
while [ "$attempt" -lt 20 ]; do
    if curl --fail --silent --max-time 3 \
        http://127.0.0.1:9001/api/health \
        | grep -q '"merc":true'; then
        break
    fi
    attempt=$((attempt + 1))
    sleep 3
done
if [ "$attempt" -ge 20 ]; then
    echo "Updated services did not become healthy within 60 seconds." >&2
    exit 1
fi

marker_tmp="$DEPLOYED_COMMIT_FILE.tmp"
printf '%s\n' "$remote_commit" >"$marker_tmp"
chmod 0644 "$marker_tmp"
mv -f "$marker_tmp" "$DEPLOYED_COMMIT_FILE"
echo "ToC update complete at $remote_commit."
