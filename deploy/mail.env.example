# Copy to /etc/toc2026/mail.env, replace the placeholders, and chmod 0600.
TOC_SMTP_HOST=mail.smtp2go.com
TOC_SMTP_PORT=2525
TOC_SMTP_SECURITY=starttls
TOC_SMTP_USERNAME=replace-with-smtp-username
TOC_SMTP_PASSWORD=replace-with-smtp-password
TOC_MAIL_FROM=Times of Chaos <replace-with-verified-sender@example.com>
TOC_MAIL_TO=replace-with-recipient@example.com
# Suppress repeat alerts for the same failure event for one hour.
TOC_MAIL_FAILURE_INTERVAL_SEC=3600
