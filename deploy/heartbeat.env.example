# /etc/toc/heartbeat.env, root's, mode 0600 (optional). toc-ops-summary
# fetches HEARTBEAT_URL every five minutes while the host is healthy, and
# BACKUP_HEARTBEAT_URL while the encrypted backup's verified copy is under
# seven hours old. A monitor alarms when a ping stops coming. On a failed
# check it fetches the URL with HEARTBEAT_FAIL_SUFFIX instead (healthchecks.io
# and Better Stack take "/fail"); set it empty to send nothing then.
# Each URL is a secret of sorts -- anyone holding it can send pings -- so it
# lives here, never in git.
HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
HEARTBEAT_FAIL_SUFFIX=/fail
