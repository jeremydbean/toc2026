# Auto detect text files and perform LF normalization
* text=auto

# Shell launchers must remain directly executable on Linux, macOS, and WSL.
*.sh text eol=lf
deploy/toc2026-* text eol=lf
# Same for the Windows-VM units and their extensionless script: a CRLF
# shebang line is rejected outright by the Linux loader.
deploy/windows-vm/* text eol=lf
# Keep reproducible Mudlet assets byte-identical on Windows and POSIX.
mudlet/*.xml text eol=lf
mudlet/package/*.xml text eol=lf
mudlet/package/*.lua text eol=lf

# Generated by tools/build_directions.py, which writes CRLF, and
# tests/test_directions_router.py checks the file byte for byte against
# a fresh generation. Without this, a Linux checkout got LF, the bytes
# never matched, and that test failed in CI on every run while passing
# on Windows, where checkouts are CRLF anyway.
area/routelist.are text eol=crlf
# Also generated by tools/build_directions.py, which writes it LF, and
# tests/test_walkto.py checks it byte for byte the same way.
area/walkto.dat text eol=lf
# CHANGES entries, read by src/changes.c.
area/changes.dat text eol=lf
