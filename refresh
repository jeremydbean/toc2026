#!/usr/bin/env bash
# Safe compatibility replacement for the old rebuild-and-pkill script.
# It builds and validates, but deliberately leaves the running service alone.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$REPO_ROOT"

make clean
make

cd area
../merc --check-area

echo "Build and area validation passed."
echo "Use an announced in-game reboot or the documented service procedure to deploy it."
